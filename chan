"---ALV Display Get Data
FORM get_data.

*
*
*  SELECT a~warpl, MAX( aufnr ) AS lastorder
*    FROM mhio
*    INTO TABLE @DATA(lt_lastorder)
*    WHERE warpl IN @so_warpl
*    GROUP BY warpl.
*
*
*  SELECT a~warpl, MIN( aufnr ) AS openorder
*    FROM mhio
*    INTO TABLE lt_openorder
*    WHERE warpl IN @so_warpl
*    AND addat IS INITIAL
*    AND aufnr IS NOT INITIAL
*    GROUP BY warpl.
*
*
*  CLEAR gt_mhio_data.
*
*   LOOP AT lt_lastorder ASSIGNING FIELD-SYMBOL(<last>).
*     APPEND VALUE ty_mhio_data(
*       warpl    = <last>-warpl
*       lastorder = <last>-lastorder ) TO gt_mhio_data.
*   ENDLOOP.
*
*   LOOP AT lt_openorder ASSIGNING FIELD-SYMBOL(<open>).
*     READ TABLE gt_mhio_data ASSIGNING FIELD-SYMBOL(<mhio>) WITH KEY warpl = <open>-warpl.
*
*   IF sy-subrc = 0.
*     <mhio>-openorder = <open>-openorder.
*    ELSE.
*    APPEND VALUE ty_mhio_data(
*     warpl = <open>-warpl
*     openorder = <open>-openorder ) TO gt_mhio_data.
*   ENDIF.
*   ENDLOOP.


  SELECT DISTINCT
       a~iwerk AS maintenance_plant,
       a~warpl AS maintenance_plan,
       a~strat AS maintenance_strat,
       a~mptyp AS maintenance_pcat,
       a~begru AS maintenance_auth,
       a~plan_sort AS maintenance_sort,
       a~stadt AS maintenance_stadt,
       a~wptxt AS maintenance_ptext,
       a~ernam AS created_by,
       a~ersdt AS created_on,
       a~wapos AS maintenance_item,
       a~tplnr AS functional_loc,
       a~equnr AS equipment_no,
       a~auart AS order_type,
       c~arbpl AS work_center,
       a~priok AS priority,
       a~wpgrp AS planner_group,
       a~ilart AS maintenance_actvt,
       a~gsber AS business_area,
       a~beber AS plant_section,
       a~plnty AS task_list_type,
       a~plnnr AS task_list_grp,
       a~plnal AS task_list_cntr,
       a~status AS item_status,
       a~pstxt AS short_text,
       a~objnr AS objnr,
       ' '     AS maintenance_stat,

  "----Additional Fields
  a~horiz           AS horiz,
  a~horiz_days      AS horiz_days,
  a~horiz_qualifier AS horiz_qualifier,
  a~kostl           AS kostl,
  a~sfakt           AS sfakt,
  a~vsneg           AS vsneg,
  a~toneg           AS toneg,
  a~fabkl           AS fabkl,
  eq~eqktx          AS eqktx,
  ifl~pltxt         AS pltxt,
  mh~aufnr          AS aufnr,
  a~vspos           AS vspos,
  a~topos           AS topos,
  a~laufn           AS laufn,
  d~ktext           AS ktext,
  a~ltknz           AS ltknz,
  a~call_confirm    AS call_confirm,
  a~andor           AS andor,
  a~hunit           AS hunit,
  a~stich           AS stich,
  a~abrho           AS abrho,
  a~iaufnr          AS iaufnr


INTO CORRESPONDING FIELDS of TABLE @gt_header
FROM vimpla AS a
LEFT JOIN crhd  AS c    ON c~objty = a~objty AND c~objid = a~gewrk
LEFT JOIN objk  AS b    ON b~obknr = a~obknr
LEFT JOIN aufk  AS d    ON d~aufnr = a~laufn
LEFT JOIN iflo  AS ifl  ON ifl~iloan = a~iloan AND ifl~spras = @sy-langu
LEFT JOIN eqkt  AS eq   ON eq~equnr = a~equnr AND eq~spras = @sy-langu
LEFT JOIN mhio  AS mh   ON mh~warpl = a~warpl
LEFT JOIN jest  AS j    ON j~objnr = a~objnr AND j~inact = @space
LEFT JOIN tj02t AS tj    ON tj~istat = j~stat  AND tj~spras = @sy-langu

   WHERE a~iwerk IN @so_iwerk
     AND a~warpl IN @so_warpl
     AND a~mptyp IN @so_mptyp
     AND a~strat IN @so_strat
     AND a~begru IN @so_begru
     AND a~plan_sort IN @so_psort
     AND a~stadt IN @so_stadt
     AND a~wptxt IN @so_wptxt
     AND a~ernam IN @so_ernam
     AND a~ersdt IN @so_ersdt
     AND a~wapos IN @so_wapos
     AND a~tplnr IN @s_itplnr
     AND a~equnr IN @so_equnr
     AND a~auart IN @so_auart
     AND c~arbpl IN @so_arbpl
     AND a~priok IN @so_priok
     AND a~wpgrp IN @so_wpgrp
     AND a~ilart IN @so_ilart
     AND a~gsber IN @so_gsber
     AND a~beber IN @so_beber
     AND a~plnnr IN @so_plnnr
     AND a~status IN @so_stat
     AND a~pstxt IN @so_stxt.

  LOOP AT gt_header ASSIGNING FIELD-SYMBOL(<ls_head>).
*    "Get MHIO data
*    READ TABLE gt_mhio_data INTO DATA(ls_mhio)
*       WITH KEY warpl = <ls_head>-maintenance_plan.
*
*    IF sy-subrc = 0.
*       <ls_head>-lastorder = ls_mhio-lastorder.
*       <ls_head>-openorder = ls_mhio-openorder.
*    ENDIF.

    " Fetch values
    DATA(lt_status) = VALUE string_table( ).
    SELECT tj02t~txt04
      INTO TABLE @DATA(lt_txts)
      FROM jest
      INNER JOIN tj02t
        ON jest~stat  = tj02t~istat
       AND tj02t~spras = @sy-langu
      WHERE jest~objnr = @<ls_head>-objnr
        AND jest~inact = @space.

    CLEAR <ls_head>-maintenance_stat.
    LOOP AT lt_txts ASSIGNING FIELD-SYMBOL(<lv_txt>).
      CONCATENATE <ls_head>-maintenance_stat <lv_txt>
             INTO <ls_head>-maintenance_stat SEPARATED BY space.
    ENDLOOP.

  ENDLOOP.



ENDFORM.

"--- Object list and Long Text

FORM prepare_items.
  DATA: lt_lines   TYPE TABLE OF tline,
        lv_name    TYPE tdobname,
        ls_header  TYPE thead,
        lv_mitem   TYPE tdobname.

  CLEAR: gt_objlist, gt_longtext, gt_item_combined, gt_item_backup.

  "=== Object List Section ===
  IF ( p_olist = 'Yes' OR p_olist = 'YES' ) AND gt_header IS NOT INITIAL.
    gv_show_olist = abap_true.

    SELECT DISTINCT
      a~warpl AS maintenance_plan,
      iflo~tplnr AS tplnr,
      objk~equnr AS equnr
      INTO TABLE @gt_objlist
      FROM vimpla AS a
      INNER JOIN objk ON a~obknr = objk~obknr
      LEFT JOIN iflo ON objk~iloan = iflo~iloan
      FOR ALL ENTRIES IN @gt_header
      WHERE a~warpl = @gt_header-maintenance_plan.

    LOOP AT gt_objlist ASSIGNING FIELD-SYMBOL(<ls_obj>).
      APPEND VALUE ty_item_combined(
        maintenance_plan = <ls_obj>-maintenance_plan
        item_type        = 'OBJLIST'
        tplnr            = <ls_obj>-tplnr
        equnr            = <ls_obj>-equnr
      ) TO gt_item_combined.
    ENDLOOP.
  ELSE.
    gv_show_olist = abap_false.
  ENDIF.


  "=== Long Text Section ===
  IF ( p_ltxt = 'Yes' OR p_ltxt = 'YES' ) AND gt_header IS NOT INITIAL.
    gv_show_ltxt = abap_true.

    LOOP AT gt_header ASSIGNING FIELD-SYMBOL(<ls_head>).

      " Skip if no long text indicator
      IF <ls_head>-ltknz <> 'X' OR <ls_head>-maintenance_item IS INITIAL.
        CONTINUE.
      ENDIF.

      CLEAR: lt_lines, lv_name, lv_mitem, ls_header.

      " Format Maintenance Item properly for MPOS long text
      lv_mitem = <ls_head>-maintenance_item.

      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = lv_mitem
        IMPORTING
          output = lv_name.

      " Ensure exactly 16 characters (e.g., 0000000000040023)
      lv_name = lv_name+0(16).

      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          client      = sy-mandt
          id          = 'LTXT'
          language    = 'EN'           " Change to sy-langu if needed
          name        = lv_name
          object      = 'MPOS'
        IMPORTING
          header      = ls_header
        TABLES
          lines       = lt_lines
        EXCEPTIONS
          not_found   = 1
          OTHERS      = 2.

      IF sy-subrc = 0 AND lt_lines IS NOT INITIAL.
        LOOP AT lt_lines ASSIGNING FIELD-SYMBOL(<ls_line>).
          APPEND VALUE ty_longtext(
            maintenance_plan = <ls_head>-maintenance_plan
            maintenance_item = <ls_head>-maintenance_item
            tdformat         = <ls_line>-tdformat
            tdline           = <ls_line>-tdline
          ) TO gt_longtext.

          APPEND VALUE ty_item_combined(
            maintenance_plan = <ls_head>-maintenance_plan
            item_type        = 'LONGTEXT'
            tdformat         = <ls_line>-tdformat
            tdline           = <ls_line>-tdline
          ) TO gt_item_combined.
        ENDLOOP.
      ELSE.
        WRITE: / 'No long text found for item:', <ls_head>-maintenance_item,
                 ' TDNAME:', lv_name, ' SUBRC:', sy-subrc.
      ENDIF.

    ENDLOOP.
  ELSE.
    gv_show_ltxt = abap_false.
  ENDIF.


  "=== Finalization ===
  SORT gt_item_combined BY maintenance_plan item_type.
  gt_item_backup = gt_item_combined.

  PERFORM apply_alv_filters.
ENDFORM.



