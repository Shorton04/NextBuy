* USER COMMAND: BUTTON ACTIONS
*---------------------------------------------------------------------*
FORM user_command_hier USING r_ucomm TYPE sy-ucomm
                             rs_selfield TYPE slis_selfield.
    CASE r_ucomm.

    WHEN '&OLIST'.
      IF gv_show_ltxt = abap_true.
        MESSAGE 'Hide the Long Text view to display the Object List.' TYPE 'I'.
        RETURN.
      ENDIF.

      IF gv_show_olist = abap_true.
        gv_show_olist = abap_false.
      ELSE.
        gv_show_olist = abap_true.
      ENDIF.

      PERFORM apply_alv_filters.
      rs_selfield-refresh = 'X'.

    WHEN '&LTXT'.
      IF gv_show_olist = abap_true.
        MESSAGE 'Hide the Object List view to display the Long Text.' TYPE 'I'.
        RETURN.
      ENDIF.

      IF gv_show_ltxt = abap_true.
        gv_show_ltxt = abap_false.
      ELSE.
        gv_show_ltxt = abap_true.
      ENDIF.

      PERFORM apply_alv_filters.
      rs_selfield-refresh = 'X'.

  ENDCASE.
ENDFORM.
