*&———————————————————————*
REPORT z_periodic_maintenance.

*–––––––––––––––––––––––––––––––––––*

- TYPE-POOLS
  *–––––––––––––––––––––––––––––––––––*
  TYPE-POOLS: slis.

*–––––––––––––––––––––––––––––––––––*

- TABLES
  *–––––––––––––––––––––––––––––––––––*
  TABLES: iflot,  “Functional Location
  t370k.  “Maintenance Planning Plant

*–––––––––––––––––––––––––––––––––––*

- SELECTION SCREEN
  *–––––––––––––––––––––––––––––––––––*
- Selection for Functional Location
  SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE TEXT-001.
  PARAMETERS: p_iwerk TYPE iwerk OBLIGATORY.  “Maintenance Plant
  SELECT-OPTIONS: s_tplnr FOR iflot-tplnr,    “Functional Location
  s_class FOR iflot-class.     “Class

SELECTION-SCREEN END OF BLOCK b1.

- Selection for Class characteristic value
  SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE TEXT-002.
  PARAMETERS: p_atinn TYPE atinn.             “Characteristic
  SELECT-OPTIONS: s_atwrt FOR cabn-atbez.     “Characteristic Value

SELECTION-SCREEN END OF BLOCK b2.

- Filter on Material text
  SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME TITLE TEXT-003.
  PARAMETERS: p_maktx TYPE maktx.             “Material Text Filter

SELECTION-SCREEN END OF BLOCK b3.

- Maintenance plan selection
  SELECTION-SCREEN BEGIN OF BLOCK b4 WITH FRAME TITLE TEXT-004.
  SELECT-OPTIONS: s_warpl FOR impt-warpl.     “Maintenance Plan

SELECTION-SCREEN END OF BLOCK b4.

- Admin. Data/Status Info
  SELECTION-SCREEN BEGIN OF BLOCK b5 WITH FRAME TITLE TEXT-005.
  SELECT-OPTIONS: s_iphas FOR iflot-iphas.    “FL status excluded

SELECTION-SCREEN END OF BLOCK b5.

- Execution mode
  SELECTION-SCREEN BEGIN OF BLOCK b6 WITH FRAME TITLE TEXT-006.
  PARAMETERS: p_test RADIOBUTTON GROUP grp1 DEFAULT ‘X’,  “Test mode
  p_effec RADIOBUTTON GROUP grp1.              “Effective mode

SELECTION-SCREEN END OF BLOCK b6.

