DATA: lt_lines TYPE TABLE OF tline,
      ls_header TYPE thead,
      lv_longtext TYPE string.

CALL FUNCTION 'READ_TEXT'
  EXPORTING
    client             = sy-mandt
    object             = 'MPOS'      " Operation text object
    id                 = 'LTXT'      " Text ID for operation long text
    name               = lv_aufnr    " Maintenance order number
    language           = sy-langu
    archive_handle     = space
    use_old_persistence= ' '
  IMPORTING
    header             = ls_header
  TABLES
    lines              = lt_lines
  EXCEPTIONS
    not_found          = 1
    access_denied      = 2
    OTHERS             = 3.

IF sy-subrc = 0.
  LOOP AT lt_lines INTO DATA(ls_line).
    CONCATENATE lv_longtext ls_line-tdline CL_ABAP_CHAR_UTILITIES=>NEWLINE INTO lv_longtext.
  ENDLOOP.
ENDIF.