- TEXT-005: Admin. Data/Status Info
- TEXT-006: Execution Mode

*–––––––––––––––––––––––––––––––––––*

- GLOBAL DATA DECLARATIONS
  *–––––––––––––––––––––––––––––––––––*
  DATA: gt_iflot TYPE TABLE OF iflot,         “Functional Locations
  gs_iflot TYPE iflot,
  gv_count TYPE i.                       “Record counter

*–––––––––––––––––––––––––––––––––––*

- INITIALIZATION
  *–––––––––––––––––––––––––––––––––––*
  INITIALIZATION.
  “ Set default values if needed

*–––––––––––––––––––––––––––––––––––*

- AT SELECTION-SCREEN
  *–––––––––––––––––––––––––––––––––––*
  AT SELECTION-SCREEN.
  “ Validate selection screen inputs

*–––––––––––––––––––––––––––––––––––*

- START-OF-SELECTION
  *–––––––––––––––––––––––––––––––––––*
  START-OF-SELECTION.
  
  PERFORM get_data.
  PERFORM process_data.
  PERFORM display_results.

*–––––––––––––––––––––––––––––––––––*

- END-OF-SELECTION
  *–––––––––––––––––––––––––––––––––––*
  END-OF-SELECTION.

*&———————————————————————*
*&      Form  GET_DATA
*&———————————————————————*
FORM get_data.

SELECT *
FROM iflot
INTO TABLE gt_iflot
WHERE tplnr IN s_tplnr
AND iwerk = p_iwerk
AND class IN s_class
AND iphas IN s_iphas.

IF sy-subrc = 0.
WRITE: / ‘Data retrieved successfully:’, sy-dbcnt, ‘records’.
ELSE.
WRITE: / ‘No data found for selection criteria’.
ENDIF.

ENDFORM.

*&———————————————————————*
*&      Form  PROCESS_DATA
*&———————————————————————*
FORM process_data.

IF p_test = ‘X’.
WRITE: / ‘Running in TEST mode - no updates will be performed’.
ELSE.
WRITE: / ‘Running in EFFECTIVE mode - data will be updated’.
ENDIF.

“ Add your processing logic here

ENDFORM.

*&———————————————————————*
*&      Form  DISPLAY_RESULTS
*&———————————————————————*
FORM display_results.

“ Display functional locations
LOOP AT gt_iflot INTO gs_iflot.
WRITE: / gs_iflot-tplnr,
gs_iflot-pltxt,
gs_iflot-iwerk.
ENDLOOP.

ENDFORM.