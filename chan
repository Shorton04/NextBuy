FORM apply_alv_filters.
  gt_item_combined = gt_item_backup.

  IF gv_show_olist = abap_false.
    DELETE gt_item_combined WHERE item_type = 'OBJLIST'.
  ENDIF.

  IF gv_show_ltxt = abap_false.
    DELETE gt_item_combined WHERE item_type = 'LONGTEXT'.
  ENDIF.
ENDFORM.
