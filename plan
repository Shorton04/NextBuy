*---------------------------------------------------------------------*
* Report: ZTR_A2R_ELASTOMER_CHANGE
* Title : Checklist for Periodic Maintenance Tasks
*---------------------------------------------------------------------*
REPORT ztr_a2r_elastomer_change.

*---------------------------------------------------------------------*
* Text Elements
*---------------------------------------------------------------------*
* text-001 = 'Selection Functional Location'
* text-002 = 'Selection for Class Characteristic Value'
* text-003 = 'Filter on Material Text'
* text-004 = 'Maint. Plan Selection'
* text-005 = 'Admin. Data / Status Info'
* text-006 = 'Mode Selection'

*---------------------------------------------------------------------*
* Selection screen
*---------------------------------------------------------------------*

"-------------------------------------------------------------*
" Functional Location Section
"-------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE text-001.
PARAMETERS:
  p_plant TYPE werks_d OBLIGATORY,         "Maintenance Plant
  p_floc  TYPE iflot-tplnr OBLIGATORY,     "Functional Location
  p_class TYPE klah-class DEFAULT 'TEEXC'. "Class
SELECTION-SCREEN END OF BLOCK b1.

"-------------------------------------------------------------*
" Class characteristic section
"-------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE text-002.
PARAMETERS:
  p_char TYPE cabn-atnam DEFAULT 'ELASTOMER_TYPE'. "Characteristic
SELECT-OPTIONS:
  s_chaval FOR ausp-atwrt.                          "Characteristic value (range)
SELECTION-SCREEN END OF BLOCK b2.

"-------------------------------------------------------------*
" Material text filter
"-------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME TITLE text-003.
SELECT-OPTIONS:
  s_matfilt FOR makt-maktx.                         "Material text filter
SELECTION-SCREEN END OF BLOCK b3.

"-------------------------------------------------------------*
" Maintenance plan selection
"-------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b4 WITH FRAME TITLE text-004.
SELECT-OPTIONS:
  s_mp FOR mpla-warpl.                              "Maintenance plan
SELECTION-SCREEN END OF BLOCK b4.

"-------------------------------------------------------------*
" Functional location status
"-------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b5 WITH FRAME TITLE text-005.
SELECT-OPTIONS:
  s_flstat FOR tj02t-istat DEFAULT 'DLFL'.          "Functional location status
SELECTION-SCREEN END OF BLOCK b5.

"-------------------------------------------------------------*
" Mode selection
"-------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK b6 WITH FRAME TITLE text-006.
PARAMETERS:
  p_test RADIOBUTTON GROUP rad1 DEFAULT 'X',        "Test mode
  p_eff  RADIOBUTTON GROUP rad1.                    "Effective mode
SELECTION-SCREEN END OF BLOCK b6.

*---------------------------------------------------------------------*
* Validation – avoid “lower > upper” popup
*---------------------------------------------------------------------*
AT SELECTION-SCREEN.
  PERFORM f_validate_ranges.

*---------------------------------------------------------------------*
* Start-of-selection – sample output
*---------------------------------------------------------------------*
START-OF-SELECTION.
  WRITE: / 'Maintenance Plant:', p_plant,
         / 'Functional Location:', p_floc,
         / 'Class:', p_class,
         / 'Characteristic:', p_char.

  LOOP AT s_chaval INTO DATA(ls_charval).
    WRITE: / 'Characteristic Value From:', ls_charval-low,
           'To:', ls_charval-high.
  ENDLOOP.

*---------------------------------------------------------------------*
* Form routines
*---------------------------------------------------------------------*
FORM f_validate_ranges.
  "check all ranges for correct order
  DATA: lv_error TYPE abap_bool VALUE abap_false.

  LOOP AT s_chaval INTO DATA(ls_char).
    IF ls_char-high IS NOT INITIAL AND ls_char-low > ls_char-high.
      MESSAGE 'Lower limit > upper limit for Characteristic Value' TYPE 'E'.
      lv_error = abap_true.
    ENDIF.
  ENDLOOP.

  LOOP AT s_matfilt INTO DATA(ls_mat).
    IF ls_mat-high IS NOT INITIAL AND ls_mat-low > ls_mat-high.
      MESSAGE 'Lower limit > upper limit for Material Filter' TYPE 'E'.
      lv_error = abap_true.
    ENDIF.
  ENDLOOP.

  LOOP AT s_mp INTO DATA(ls_mp).
    IF ls_mp-high IS NOT INITIAL AND ls_mp-low > ls_mp-high.
      MESSAGE 'Lower limit > upper limit for Maintenance Plan' TYPE 'E'.
      lv_error = abap_true.
    ENDIF.
  ENDLOOP.

  LOOP AT s_flstat INTO DATA(ls_fl).
    IF ls_fl-high IS NOT INITIAL AND ls_fl-low > ls_fl-high.
      MESSAGE 'Lower limit > upper limit for FL Status' TYPE 'E'.
      lv_error = abap_true.
    ENDIF.
  ENDLOOP.

  IF lv_error = abap_true.
    STOP.
  ENDIF.
ENDFORM.