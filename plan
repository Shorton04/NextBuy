*---------------------------------------------------------------------*
* Report: ZPM_ELASTOMER_UPDATE
* Title : Checklist for Periodic Maintenance Tasks
*---------------------------------------------------------------------*
REPORT zpm_elastomer_update.

*---------------------------------------------------------------------*
* Text Elements
*---------------------------------------------------------------------*
* text-001 = 'Selection Functional Location'
* text-002 = 'Selection for Class Characteristic Value'
* text-003 = 'Filter on Material Text'
* text-004 = 'Maint. Plan Selection'
* text-005 = 'Admin Data / Status Info'
* text-006 = 'Mode Selection'

*---------------------------------------------------------------------*
* SELECTION SCREEN
*---------------------------------------------------------------------*

SELECTION-SCREEN BEGIN OF BLOCK b1 WITH FRAME TITLE text-001.
PARAMETERS:
  p_plant TYPE iflo-swerk OBLIGATORY,               " Maintenance Plant
  p_floc  TYPE iflot-tplnr OBLIGATORY,              " Functional Location
  p_class TYPE klah-class DEFAULT 'TEEXC'.          " Class
SELECTION-SCREEN END OF BLOCK b1.

SELECTION-SCREEN BEGIN OF BLOCK b2 WITH FRAME TITLE text-002.
PARAMETERS:
  p_char   TYPE cabn-atnam DEFAULT 'ELASTOMER_TYPE', " Characteristic Name
  p_chaval TYPE c LENGTH 40.                         " Characteristic Value
SELECTION-SCREEN END OF BLOCK b2.

SELECTION-SCREEN BEGIN OF BLOCK b3 WITH FRAME TITLE text-003.
PARAMETERS:
  p_matfilt TYPE makt-maktx.                         " Material Description Filter
SELECTION-SCREEN END OF BLOCK b3.

SELECTION-SCREEN BEGIN OF BLOCK b4 WITH FRAME TITLE text-004.
PARAMETERS:
  p_mp TYPE c LENGTH 12.                             " Maintenance Plan
SELECTION-SCREEN END OF BLOCK b4.

SELECTION-SCREEN BEGIN OF BLOCK b5 WITH FRAME TITLE text-005.
PARAMETERS:
  p_flstat TYPE c LENGTH 10 DEFAULT 'DLFL'.          " Functional Location Status
SELECTION-SCREEN END OF BLOCK b5.

SELECTION-SCREEN BEGIN OF BLOCK b6 WITH FRAME TITLE text-006.
PARAMETERS:
  p_test RADIOBUTTON GROUP rad1 DEFAULT 'X' USER-COMMAND rad, " Test Mode
  p_eff  RADIOBUTTON GROUP rad1.                              " Effective Mode
SELECTION-SCREEN END OF BLOCK b6.

*---------------------------------------------------------------------*
* AT SELECTION-SCREEN VALIDATION
*---------------------------------------------------------------------*
AT SELECTION-SCREEN.

  " Ensure characteristic value entered
  IF p_chaval IS INITIAL.
    MESSAGE 'Please enter at least one characteristic value.' TYPE 'E'.
  ENDIF.

*---------------------------------------------------------------------*
* START-OF-SELECTION
*---------------------------------------------------------------------*
START-OF-SELECTION.

  WRITE: / '-----------------------------------------------',
         / 'Selection Summary',
         / '-----------------------------------------------'.

  WRITE: / 'Maintenance Plant: ', p_plant,
         / 'Functional Location: ', p_floc,
         / 'Class: ', p_class,
         / 'Characteristic: ', p_char,
         / 'Characteristic Value: ', p_chaval.

  IF p_matfilt IS NOT INITIAL.
    WRITE: / 'Material Filter: ', p_matfilt.
  ENDIF.

  IF p_mp IS NOT INITIAL.
    WRITE: / 'Maintenance Plan: ', p_mp.
  ENDIF.

  IF p_flstat IS NOT INITIAL.
    WRITE: / 'Functional Location Status: ', p_flstat.
  ENDIF.

  IF p_test = 'X'.
    WRITE: / 'Mode: TEST (No update will be done)'.
  ELSEIF p_eff = 'X'.
    WRITE: / 'Mode: EFFECTIVE (Actual updates will be performed)'.
  ENDIF.

  WRITE: / '-----------------------------------------------'.
  WRITE: / 'Program ready for next development phase (data fetch and update logic).'.

*---------------------------------------------------------------------*
* END OF PROGRAM
*---------------------------------------------------------------------*