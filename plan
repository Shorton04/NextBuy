*---------------------------------------------------------------------*
* Send CMXS user status to order (robust, dynamic userstatus mapping)
*---------------------------------------------------------------------*
FORM f_send_cmx.
  DATA ls_output LIKE LINE OF gt_output.

  LOOP AT gt_output ASSIGNING FIELD-SYMBOL(<ls_output_row>).

    " Local tables / work areas
    DATA: lt_header  TYPE TABLE OF bapi_alm_order_headers_i,
          lt_status  TYPE TABLE OF bapi_alm_order_usrstat,
          lt_methods TYPE TABLE OF bapi_alm_order_method,
          lt_return  TYPE TABLE OF bapiret2.

    " method / header work areas (static, always safe)
    DATA: ls_header TYPE bapi_alm_order_headers_i,
          ls_method TYPE bapi_alm_order_method,
          ls_return TYPE bapiret2.

    CLEAR: lt_header, lt_status, lt_methods, lt_return.

    " ---------------------------------------------------------
    " Header: tell BAPI which order to update (minimal)
    " ---------------------------------------------------------
    CLEAR ls_header.
    ls_header-orderid = <ls_output_row>-aufnr.
    APPEND ls_header TO lt_header.

    " ---------------------------------------------------------
    " Build dynamic USERSTATUS row (type = bapi_alm_order_usrstat)
    " ---------------------------------------------------------
    DATA lr_usrstat TYPE REF TO bapi_alm_order_usrstat.
    FIELD-SYMBOLS: <fs_usrstat> TYPE bapi_alm_order_usrstat,
                   <fs_comp>    TYPE any.

    CREATE DATA lr_usrstat.
    ASSIGN lr_usrstat->* TO <fs_usrstat>.

    " 1) set order identifier (try ORDERID then OBJNR)
    IF ASSIGN COMPONENT 'ORDERID' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = <ls_output_row>-aufnr.
    ELSEIF ASSIGN COMPONENT 'OBJNR' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      TRY.
          <fs_comp> = <ls_output_row>-aufnr.
        CATCH cx_sy_move_cast_error.
          " fallback logic for OBJNR if needed
      ENDTRY.
    ENDIF.

    " 2) set the internal user status code (try standard names)
    IF ASSIGN COMPONENT 'USER_ST' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = 'E0014'.            " internal code for CMXS
    ELSEIF ASSIGN COMPONENT 'USERSTATUS' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = 'E0014'.
    ELSEIF ASSIGN COMPONENT 'USER_ST_TEXT' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = 'CMXS'.             " fallback text
    ENDIF.

    " 3) set the reference number so BAPI can link method -> data
    DATA lv_refno TYPE string VALUE '000002'. " must match method refnumber
    IF ASSIGN COMPONENT 'REFNUMBER' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = lv_refno.
    ELSEIF ASSIGN COMPONENT 'REFNO' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = lv_refno.
    ELSEIF ASSIGN COMPONENT 'REFNR' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = lv_refno.
    ELSEIF ASSIGN COMPONENT 'REF' OF STRUCTURE <fs_usrstat> TO <fs_comp>.
      <fs_comp> = lv_refno.
    ENDIF.

    " append the dynamic row into the statically typed table
    APPEND <fs_usrstat> TO lt_status.

    " ---------------------------------------------------------
    " Build methods table — must match refnumber
    " ---------------------------------------------------------
    CLEAR ls_method.
    ls_method-refnumber  = '000001'.
    ls_method-objecttype = 'HEADER'.
    ls_method-method     = 'CHANGE'.
    ls_method-objectkey  = <ls_output_row>-aufnr.
    APPEND ls_method TO lt_methods.

    CLEAR ls_method.
    ls_method-refnumber  = lv_refno.            
    ls_method-objecttype = 'HEADER'.            
    ls_method-method     = 'USERSTATUS'.        
    ls_method-objectkey  = <ls_output_row>-aufnr.
    APPEND ls_method TO lt_methods.

    CLEAR ls_method.
    ls_method-refnumber  = '000003'.
    ls_method-objecttype = 'HEADER'.
    ls_method-method     = 'SAVE'.              
    ls_method-objectkey  = <ls_output_row>-aufnr.
    APPEND ls_method TO lt_methods.

    " ---------------------------------------------------------
    " Call BAPI
    " ---------------------------------------------------------
    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES
        it_header     = lt_header
        it_methods    = lt_methods
        it_userstatus = lt_status
        return        = lt_return
      EXCEPTIONS
        OTHERS        = 1.

    IF sy-subrc <> 0.
      <ls_output_row>-msg = |BAPI call failed (SY-SUBRC={ sy-subrc })|.
    ELSE.
      " read errors
      READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
      IF sy-subrc = 0.
        <ls_output_row>-msg = ls_return-message.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      ELSE.
        <ls_output_row>-msg = 'CMXS status updated successfully'.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
      ENDIF.
    ENDIF.

    " Always log result
    PERFORM f_write_log USING <ls_output_row>-aufnr
                               <ls_output_row>-vornr
                               <ls_output_row>-werks
                               'CMXS'
                               <ls_output_row>-msg.

  ENDLOOP.

  COMMIT WORK.
ENDFORM.