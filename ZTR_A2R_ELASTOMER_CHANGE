****--------------------------------------------------------------------*
****        ==>> Using Parameters                                       *
****            -->> TPLNR                                              *
****--------------------------------------------------------------------*
***FORM w10_v_equi USING v_equi_tplnr.
***  CLEAR   ta_v_equi.
***  REFRESH ta_v_equi.
***  SELECT equnr matnr submt objnr
***         FROM  v_equi
***         INTO  (v_equi-equnr, v_equi-matnr,
***                v_equi-submt, v_equi-objnr)
***         WHERE tplnr EQ v_equi_tplnr
***         AND   swerk IN s_swerk
***         AND   datbi >= sy-datum.
***    CLEAR ta_v_equi.
***    ta_v_equi-equnr = v_equi-equnr.
***    ta_v_equi-matnr = v_equi-matnr.
***    ta_v_equi-submt = v_equi-submt.
***    ta_v_equi-objnr = v_equi-objnr.
***    COLLECT ta_v_equi.
***  ENDSELECT.
***
***  LOOP AT ta_v_equi.
****........je EQUI neue Zeile...........................................
***    FORMAT COLOR 5 INTENSIFIED ON.
***    MOVE ta_v_equi-equnr TO wa_equnr.
***    MOVE ta_v_equi-equnr TO taalv_zmvi0059_1-equnr.
***
***    FORMAT RESET.
***    SELECT SINGLE eqktx
***           FROM   eqkt
***           INTO   eqkt-eqktx
***           WHERE  equnr EQ ta_v_equi-equnr
***           AND    spras EQ sy-langu.
***    IF sy-subrc <> 0.
***      CLEAR eqkt-eqktx.
***    ENDIF.
***
***    MOVE ta_v_equi-equnr TO wa_equnr.
***    IF wa_equnr IS NOT INITIAL.
***      MOVE eqkt-eqktx TO wa_zzeqktx.
***    ENDIF.
***
***    READ TABLE taalv_zmvi0059_1 WITH KEY zztecho = wa_strno.
***    IF sy-subrc = 0 AND
***      taalv_zmvi0059_1-equnr IS INITIAL.
***      MOVE wa_equnr   TO taalv_zmvi0059_1-equnr.
***      IF taalv_zmvi0059_1-equnr IS NOT INITIAL.
***        MOVE eqkt-eqktx TO taalv_zmvi0059_1-zzeqktx.
***      ENDIF.
***      MODIFY taalv_zmvi0059_1 INDEX sy-tabix.
***
***    ELSE.
***      CLEAR taalv_zmvi0059_1.
***      MOVE wa_strno   TO taalv_zmvi0059_1-zztecho.
***      MOVE wa_ktx01   TO taalv_zmvi0059_1-ktx01.
***      MOVE wa_equnr   TO taalv_zmvi0059_1-equnr.
***      MOVE wa_zzeqktx TO taalv_zmvi0059_1-zzeqktx.
***      COLLECT taalv_zmvi0059_1.
***    ENDIF.
***
****........je Material-Nr neue Zeile....................................
***    CLEAR zz_stlst.
***    CLEAR zz_stlnr.
***    IF NOT ta_v_equi-matnr IS INITIAL.
***      PERFORM select_mara USING ta_v_equi-matnr.
***      PERFORM select_single_mast USING ta_v_equi-matnr.     "SiL020507
***      IF sy-subrc <> 0.
***        CLEAR ta_new.
***        MOVE ta_v_equi-matnr TO ta_new-idnrk.
***        ADD  1               TO ta_new-menge.
***        MOVE mara-meins      TO ta_new-meins.
***        MOVE wa_strno        TO ta_new-strno.
***        MOVE wa_equnr        TO ta_new-equnr.
***        COLLECT ta_new.
***      ENDIF.
***    ENDIF.
***
****........Stückliste...................................................
***    IF NOT ta_v_equi-submt IS INITIAL.
***      PERFORM w10_stueli_lesen USING ta_v_equi-submt.
***    ENDIF.
***  ENDLOOP.
***ENDFORM.           " w10_v_equi
