****   FORM w30_F005                                                    *
****--------------------------------------------------------------------*
****        Weiterverarbeitung TA_INP                                   *
****--------------------------------------------------------------------*
****        ==> keine Using Parameters                                  *
****--------------------------------------------------------------------*
***FORM w30_f005.
***  CLEAR zz_retcd.
***
***  WHILE zz_retcd EQ 0.
***    LOOP AT ta_sel.
***      IF ta_sel-posnr = '0000'.
***      ELSE.
***        PERFORM select_mast_fill_taout USING ta_sel-idnrk.  "SiL020507
****       select * from mast
****                where matnr eq ta_sel-idnrk
****                and   werks in s_swerk
****                and   stlan eq '4'.
****         move mast-matnr to ta_out-matnr.
****         move mast-stlnr to ta_out-stlnr.
****         move mast-stlan to ta_out-stlan.
****         zz_stufe = ta_sel-stufe + 1.
****         move zz_stufe   to ta_out-stufe.
****         move '0000'     to ta_out-posnr.
****         collect ta_out.
****       endselect.
***        IF sy-subrc = 0.
***          MOVE mast-matnr TO zz_matnr.
***          MOVE mast-stlnr TO zz_stlnr.
***          MOVE mast-stlan TO zz_stlan.
***          PERFORM w30_call_function_get_stpo USING mast-stlnr 'M'.
***        ENDIF.
***        PERFORM w30_f015.
***      ENDIF.
***    ENDLOOP.
***
***    PERFORM w30_f020.
