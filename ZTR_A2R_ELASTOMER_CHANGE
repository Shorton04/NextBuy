****--------------------------------------------------------------------*
****   FORM W30_CALL_FUNCTION_GET_STPO                                  *
****--------------------------------------------------------------------*
****        .......................                                     *
****--------------------------------------------------------------------*
****        ===> USING Parameters                                       *
****             --->> STPOB_STLNR                                      *
****                   STPOB_STLTY                                      *
****--------------------------------------------------------------------*
***FORM w30_call_function_get_stpo USING stpob_stlnr stpob_stlty.
***  CLEAR   stpob.
***  REFRESH stpob.
***  FREE    stpob.
***  stpob-stlnr = stpob_stlnr.
***  stpob-stlty = stpob_stlty.
***
***  CALL FUNCTION 'GET_STPO'
***    EXPORTING
***      all             = 'X'
***      alter           = ' '
***      datub           = c_datub
***      datuv           = c_datuv
***      no_buffer       = ' '
***      set             = 'X'
***      valid           = ' '
***    TABLES
***      add_wa          = istar
***      wa              = stpob
***    EXCEPTIONS
***      call_invalid    = 01
***      end_of_table    = 02
***      get_without_set = 03
***      key_incomplete  = 04
***      key_invalid     = 05
***      no_record_found = 06.
***
***  CLEAR   stpox.
***  REFRESH stpox.
***  FREE    stpox.
***
***  SORT stpob BY stlty
***                stlnr
***                stlkn
***                datuv.
***
***  CLEAR zz_stpoxi.
***  LOOP AT stpob.
***    CLEAR stpox.
***    PERFORM w30_select_stas.
***    SORT stasx BY stlty
***                  stlnr
***                  stlkn
***                  datuv.
***
***    IF sy-subrc > 0.
***      MOVE-CORRESPONDING stpob TO stpox.
***      APPEND stpox.
***      zz_stpoxi = zz_stpoxi + 1.
***    ENDIF.
***
***    LOOP AT stasx.
***      MOVE-CORRESPONDING stpob TO stpox.
***      IF stasx-lkenz = 'X'.
***        stpox-datub = stasx-datuv.
***        MODIFY stpox INDEX zz_stpoxi.
***      ELSE.
***        APPEND stpox.
***        zz_stpoxi = zz_stpoxi + 1.
***      ENDIF.
***    ENDLOOP.
***  ENDLOOP.
***
***  SORT stpox BY posnr datub.
***
***  CLEAR   stpob.
***  REFRESH stpob.
***  FREE    stpob.
***
***  LOOP AT stpox.
***    CLEAR stpob.
***    IF stpox-datub >= sy-datum.
***      MOVE-CORRESPONDING stpox TO stpob.
***      APPEND stpob.
***    ENDIF.
***  ENDLOOP.
***
***  LOOP AT stpob.
***    CLEAR ta_out.
***    MOVE zz_matnr      TO ta_out-matnr.
***    MOVE zz_stlnr      TO ta_out-stlnr.
***    MOVE zz_stlan      TO ta_out-stlan.
***    MOVE zz_stufe      TO ta_out-stufe.
***    MOVE stpob-posnr   TO ta_out-posnr.
***    MOVE stpob-idnrk   TO ta_out-idnrk.
***    MOVE stpob-stlty   TO ta_out-stlty.
***    MOVE stpob-stlkn   TO ta_out-stlkn.
***    MOVE stpob-stpoz   TO ta_out-stpoz.
***    MOVE stpob-menge   TO ta_out-menge.
***    MOVE stpob-meins   TO ta_out-meins.
***    MOVE wa_strno      TO ta_out-strno.
***    MOVE wa_equnr      TO ta_out-equnr.
***    COLLECT ta_out.
***  ENDLOOP.
***ENDFORM.               " w30_call_function_get_stpo
***
