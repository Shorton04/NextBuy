****&---------------------------------------------------------------------*
****&      Form  SELECT_CLASS_DATA
****&---------------------------------------------------------------------*
****       text
****----------------------------------------------------------------------*
****  -->  p1        text
****  <--  p2        text
****----------------------------------------------------------------------*
***FORM select_class_data USING zz_tplnr.
***
***  CLEAR   ttpklass. CLEAR   ttpkldat.
***  CLEAR   ttpchar.
***  REFRESH ttpklass. REFRESH ttpkldat.
***  REFRESH ttpchar.
***  CLEAR: z_objnr .
***  CLEAR: gv_objty.
***  z_objnr = zz_tplnr.
***
***  CALL FUNCTION 'CLAF_CLASSIFICATION_OF_OBJECTS'
***    EXPORTING
***      class                = 'TEEXC'
***      classtext            = 'X'
***      classtype            = '003'
***      features             = 'X'
***      object               = z_objnr
***      key_date             = sy-datum
***      initial_charact      = ' '
***      change_service_clf   = 'X'
***    TABLES
***      t_class              = ttpklass
***      t_objectdata         = ttpkldat
***      i_sel_characteristic = ttpchar
***    EXCEPTIONS
***      no_classification    = 1
***      no_classtypes        = 2
***      invalid_class_type   = 3
***      OTHERS               = 4.
***
***  IF sy-subrc <> 0.
****   MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
****           WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
***  ENDIF.
***
***  READ TABLE ttpkldat WITH KEY atnam = ttpkldat-atnam.
****  gv_subrc = sy-subrc.
***
***  IF sy-subrc = 0.
****  IF sy-subrc NE 0.
****    EXIT.
****  ENDIF.
***
****    gv_objty = ttpkldat-ausp1.
***    READ TABLE ta_cawnt WITH KEY atwtb = ttpkldat-ausp1.
***    IF sy-subrc = 0.
***
***      gv_objty = ta_cawnt-objty.
***
***    ENDIF.
***  ENDIF.
***
***ENDFORM.                    " SELECT_CLASS_DATA
