***FORM fetch_class_floc .
***
***  IF s_class-low IS NOT INITIAL.
***
***    CLEAR lv_clint.
***    SELECT SINGLE clint
***       FROM   klah
***       INTO   lv_clint
***       WHERE  class IN s_class "co_class
***       AND    klart EQ co_klart.
***
***    SELECT objek
***       FROM   kssk
***       INTO   CORRESPONDING FIELDS OF TABLE tt_kssk
***       WHERE  mafid EQ co_mafid
***       AND    klart EQ co_klart
***       AND    clint EQ lv_clint.
***
***    IF sy-subrc <> 0.
***      MESSAGE e015(zi) WITH text-m01.
***    ENDIF.
***
***    CLEAR   tt_inob.
***    REFRESH tt_inob.
***
***    LOOP AT tt_kssk INTO ls_kssk.
***      SELECT objek
***             FROM  inob
***             APPENDING CORRESPONDING FIELDS OF TABLE tt_inob
***             WHERE cuobj EQ ls_kssk-objek
***             AND   klart EQ co_klart
***             AND   obtab EQ co_tabnm_iflot.
***
***      IF sy-subrc <> 0.
****      message e015(ZI) with text-m01.
***      ENDIF.
***    ENDLOOP.
***
***    SORT tt_inob BY objek.
***    DELETE ADJACENT DUPLICATES FROM tt_inob COMPARING objek.
***
***  ENDIF.
***
***ENDFORM.                    " FETCH_CLASS_FLOC
