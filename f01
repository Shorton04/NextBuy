FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_TITLE) TYPE STRING DEFAULT 'ALV'
*"  EXPORTING
*"     REFERENCE(EV_CHOICE) TYPE FLAG
*"  CHANGING
*"     REFERENCE(IT_TABLE) TYPE STANDARD TABLE OPTIONAL
*"----------------------------------------------------------------------
  DATA: lo_container TYPE REF TO cl_gui_dialogbox_container,
        lo_salv      TYPE REF TO cl_salv_table,
        lo_functions TYPE REF TO cl_salv_functions,
        lo_columns   TYPE REF TO cl_salv_columns_table,
        lo_display   TYPE REF TO cl_salv_display_settings,
        lv_answer    TYPE c,
        lv_caption   TYPE string.

  FIELD-SYMBOLS: <fs_table> TYPE STANDARD TABLE.

  IF it_table IS INITIAL.
    MESSAGE 'No data to display in popup table.' TYPE 'I'.
    RETURN.
  ENDIF.

  TRY.
      " Container title
      lv_caption = iv_title.

      " Create popup container window for ALV
      CREATE OBJECT lo_container
        EXPORTING
          caption = lv_caption
          top     = 10
          left    = 10
          width   = 150
          height  = 40.

      " Create SALV Table inside popup
      cl_salv_table=>factory(
        EXPORTING
          r_container  = lo_container
        IMPORTING
          r_salv_table = lo_salv
        CHANGING
          t_table      = it_table ).

      " Display options and enhancements
      lo_functions = lo_salv->get_functions( ).
      lo_functions->set_all( abap_true ).

      lo_display = lo_salv->get_display_settings( ).
      lo_display->set_striped_pattern( abap_true ).
      lo_display->set_list_header( iv_title ).

      lo_columns = lo_salv->get_columns( ).
      lo_columns->set_optimize( abap_true ).

      " Display popup table
      lo_salv->display( ).

      " Ask user if want to continue
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar       = iv_title
          text_question  = 'Do you want to continue to the next step?'
          text_button_1  = 'Yes'
          text_button_2  = 'No'
          default_button = '1'
        IMPORTING
          answer         = lv_answer.

      IF lv_answer = '1'.
        ev_choice = abap_false. " Continue
      ELSE.
        ev_choice = abap_true.  " Stop
      ENDIF.

      " Clean up the container
      FREE lo_container.

    CATCH cx_salv_msg INTO DATA(lx_msg).
      MESSAGE lx_msg->get_text( ) TYPE 'E'.
  ENDTRY.

ENDFUNCTION.