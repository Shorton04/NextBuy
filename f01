  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: fetch_orders
*---------------------------------------------------------------------*
FORM fetch_orders.
  CLEAR gt_orders.

  SELECT a~aufnr, a~auart, b~iwerk, a~erdat, c~gstrp, c~gltrp, a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND b~iwerk IN @s_iwerk
    INTO TABLE @gt_orders.

  IF gt_orders IS INITIAL.
    MESSAGE i008(ZA2R_KCMPMSG). "No orders found
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_by_jest
*---------------------------------------------------------------------*
FORM filter_by_jest.
  DATA lt_keep TYPE TABLE OF lty_order.

  SELECT DISTINCT a~aufnr, a~auart, b~iwerk, a~erdat, c~gstrp, c~gltrp, a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    INNER JOIN jest AS j ON a~objnr = j~objnr
    WHERE j~inact = @space
      AND j~stat IN @s_statin
      AND j~stat NOT IN @s_statex
      AND a~aufnr IN @s_aufnr
      AND b~iwerk IN @s_iwerk
    INTO TABLE @lt_keep.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_has_components
*---------------------------------------------------------------------*
FORM filter_has_components.
  DATA lt_keep TYPE TABLE OF lty_order.

  SELECT a~aufnr, a~auart, b~iwerk, a~erdat, c~gstrp, c~gltrp, a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE EXISTS (
      SELECT 1 FROM resb AS r
        WHERE r~aufnr = a~aufnr
          AND r~xloek = @space )
      AND a~aufnr IN @s_aufnr
    INTO TABLE @lt_keep.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.

  DATA: lt_incomplete TYPE TABLE OF aufk-aufnr,
        lv_estat TYPE jest-stat,
        lv_kcmp_active TYPE abap_bool,
        lv_txt TYPE string.

  SELECT DISTINCT r~aufnr
    FROM resb AS r
    INNER JOIN aufk AS a ON a~aufnr = r~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND r~xloek = @space
      AND r~enmng < r~bdmng
    INTO TABLE @lt_incomplete.

  LOOP AT gt_orders INTO DATA(ls_order).

    CLEAR lv_kcmp_active.
    SELECT SINGLE stat
      INTO @lv_estat
      FROM jest
      WHERE objnr = @ls_order-objnr
        AND inact = @space
        AND stat = @gc_estat.

    IF sy-subrc = 0.
      lv_kcmp_active = abap_true.
    ENDIF.

    READ TABLE lt_incomplete WITH TABLE KEY table_line = ls_order-aufnr TRANSPORTING NO FIELDS.

    IF lv_kcmp_active = abap_true.
      MESSAGE i014(ZA2R_KCMPMSG) WITH ls_order-aufnr INTO lv_txt.
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = lv_txt
                      light  = 'Y' ) TO gt_log.

    ELSEIF sy-subrc = 0.
      MESSAGE i015(ZA2R_KCMPMSG) WITH ls_order-aufnr INTO lv_txt.
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = lv_txt
                      light  = 'R' ) TO gt_log.

    ELSE.
      MESSAGE i016(ZA2R_KCMPMSG) WITH ls_order-aufnr INTO lv_txt.
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = lv_txt
                      light  = 'G' ) TO gt_log.
    ENDIF.

  ENDLOOP.

ENDFORM.

