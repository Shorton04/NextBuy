*& Include  ZTR_A2D_REV_RECOG_CONSMAT_F01
*&---------------------------------------------------------------------*

*---------------------------------------------------------------------*
*      Form  INIT_DATA
*---------------------------------------------------------------------*
FORM init_data.
  DATA: lt_mtart TYPE STANDARD TABLE OF mara-mtart,
        lv_datum TYPE datum,
        ls_param TYPE ztxca_param.

"Default Material Types as per Custom Lookup
  CLEAR: s_mtart[], s_mtart.
  SELECT SINGLE * FROM ztxca_param INTO @ls_param
    WHERE kdef01 = 'ZKROHRECOG_MATTYPE_SELECTION'
      AND kval03 = 'MTART'
      AND pval01 = 'X'.

  IF sy-subrc = 0.
    IF NOT ls_param-pval02 IS INITIAL.
      CLEAR lt_mtart.
      SPLIT ls_param-pval02 AT ',' INTO TABLE lt_mtart.
      LOOP AT lt_mtart INTO DATA(ls_mtart) WHERE table_line IS NOT INITIAL.
        s_mtart-sign   = 'I'.
        s_mtart-option = 'EQ'.
        s_mtart-low    = ls_mtart.
        APPEND s_mtart.
      ENDLOOP.
    ENDIF.

    IF NOT ls_param-pval03 IS INITIAL.
      CLEAR lt_mtart.
      SPLIT ls_param-pval03 AT ',' INTO TABLE lt_mtart.
      LOOP AT lt_mtart INTO ls_mtart WHERE table_line IS NOT INITIAL.
        s_mtart-sign   = 'I'.
        s_mtart-option = 'EQ'.
        s_mtart-low    = ls_mtart.
        APPEND s_mtart.
      ENDLOOP.
    ENDIF.

    IF NOT ls_param-pval04 IS INITIAL.
      CLEAR lt_mtart.
      SPLIT ls_param-pval04 AT ',' INTO TABLE lt_mtart.
      LOOP AT lt_mtart INTO ls_mtart WHERE table_line IS NOT INITIAL.
        s_mtart-sign   = 'I'.
        s_mtart-option = 'EQ'.
        s_mtart-low    = ls_mtart.
        APPEND s_mtart.
      ENDLOOP.
    ENDIF.
  ENDIF.

"Set Month end Date as default based on Current Date
  CLEAR: s_exdate[], s_exdate.
  lv_datum = sy-datum.
  CALL FUNCTION 'RP_LAST_DAY_OF_MONTHS'
    EXPORTING
      day_in = lv_datum
    IMPORTING
      last_day_of_month = lv_datum
    EXCEPTIONS
      day_in_no_date = 1
      OTHERS         = 2.
  IF sy-subrc = 0.
    s_exdate-sign   = 'I'.
    s_exdate-option = 'LE'.
    s_exdate-low    = lv_datum.
    APPEND s_exdate.
    CLEAR s_exdate.
  ENDIF.

"Capture Default Values into global backup ranges (gt_)
  gt_psphi  = s_psphi[].
  gt_pspnr  = s_pspnr[].
  gt_werks  = s_werks[].
  gt_charg  = s_charg[].
  gt_matnr  = s_matnr[].
  gt_mtart  = s_mtart[].
  gt_exdate = s_exdate[].
  gt_amtsr  = s_amtsr[].
  gt_ernam  = s_ernam[].
  gt_erdat  = s_erdat[].
  gt_status = s_status[].
  lv_batrel = p_batrel.
ENDFORM.

*---------------------------------------------------------------------*
*      Form  VALIDATE_DATA
*---------------------------------------------------------------------*
FORM validate_data.
*Check for Mandatory Fields
  CASE sy-ucomm.
    WHEN 'EXECUTE'.
      CASE abap_true.
        WHEN p_rb1.
          IF s_werks[] IS INITIAL.
            MESSAGE 'Please Maintain Plant' TYPE 'E'.
          ENDIF.
          IF s_charg[] IS INITIAL.
            MESSAGE 'Please Maintain Batch' TYPE 'E'.
          ENDIF.
        WHEN p_rb2.
          IF s_psphi[] IS INITIAL AND s_pspnr[] IS INITIAL.
            MESSAGE 'Please Maintain either Project or WBS' TYPE 'E'.
          ENDIF.
      ENDCASE.

    WHEN 'REC'.
      "Restore from saved global ranges (gt_) to select-options (s_)
      s_psphi[]  = gt_psphi[].
      s_pspnr[]  = gt_pspnr[].
      s_werks[]  = gt_werks[].
      s_charg[]  = gt_charg[].
      s_matnr[]  = gt_matnr[].
      s_mtart[]  = gt_mtart[].
      s_exdate[] = gt_exdate[].
      s_amtsr[]  = gt_amtsr[].
      s_ernam[]  = gt_ernam[].
      s_erdat[]  = gt_erdat[].
      s_status[] = gt_status[].
      p_batrel   = lv_batrel.
  ENDCASE.
ENDFORM.

*---------------------------------------------------------------------*
*      Form  MODIFY_SCREEN
*---------------------------------------------------------------------*
FORM modify_screen.
  LOOP AT SCREEN.
    CASE screen-group1.
      WHEN 'M1'.
        IF p_rb1 IS INITIAL.
          screen-active = 0.
        ENDIF.
      WHEN 'M2'.
        IF p_rb2 IS INITIAL.
          screen-active = 0.
        ENDIF.
      WHEN 'M3'.
        IF p_rb3 IS INITIAL.
          screen-active = 0.
        ENDIF.
      WHEN 'M4'.
        IF NOT p_rb1 IS INITIAL.
          screen-active = 0.
        ENDIF.
      WHEN 'M5'.
        IF NOT p_rb2 IS INITIAL.
          screen-active = 0.
        ENDIF.
    ENDCASE.
    MODIFY SCREEN.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------------*
*      Form  BDC_DYNPRO
*---------------------------------------------------------------------*
FORM bdc_dynpro USING iv_program iv_dynpro
                CHANGING ct_bdcdata TYPE bdcdata_tab.
  CLEAR ls_bdcdata.
  ls_bdcdata-program  = iv_program.
  ls_bdcdata-dynpro   = iv_dynpro.
  ls_bdcdata-dynbegin = 'X'.
  APPEND ls_bdcdata TO ct_bdcdata.
ENDFORM.

*---------------------------------------------------------------------*
*      Form  BDC_FIELD
*---------------------------------------------------------------------*
FORM bdc_field USING iv_fnam iv_fval
               CHANGING ct_bdcdata TYPE bdcdata_tab.
  CLEAR ls_bdcdata.
  ls_bdcdata-fnam = iv_fnam.
  WRITE iv_fval TO ls_bdcdata-fval LEFT-JUSTIFIED.
  APPEND ls_bdcdata TO ct_bdcdata.
ENDFORM.