*---------------------------------------------------------------------*
* FORM display_execution_log
*---------------------------------------------------------------------*
FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns,
        lo_col  TYPE REF TO cl_salv_column.

  TRY.
      " Create ALV from internal table
      cl_salv_table=>factory(
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table      = gt_log ).

      " Enable standard ALV functions
      lo_alv->get_functions( )->set_all( abap_true ).
      lo_alv->get_columns( )->set_optimize( abap_true ).

      "--------------------------------------------------------------*
      " Set column headers and traffic light
      "--------------------------------------------------------------*
      lo_cols = lo_alv->get_columns( ).

      lo_cols->get_column( 'AUFNR' )->set_medium_text( 'Order' ).
      lo_cols->get_column( 'AUART' )->set_medium_text( 'Order Type' ).
      lo_cols->get_column( 'IWERK' )->set_medium_text( 'Plant' ).
      lo_cols->get_column( 'ERDAT' )->set_medium_text( 'Created On' ).
      lo_cols->get_column( 'GSTRP' )->set_medium_text( 'Basic Start' ).
      lo_cols->get_column( 'GLTRP' )->set_medium_text( 'Basic Finish' ).
      lo_cols->get_column( 'MSGTXT' )->set_medium_text( 'Status Message' ).

      lo_col = lo_cols->get_column( 'LIGHT' ).
      lo_col->set_medium_text( 'Result' ).
      lo_col->set_icon( abap_true ).

      "--------------------------------------------------------------*
      " Display ALV output
      "--------------------------------------------------------------*
      lo_alv->display( ).

    CATCH cx_salv_not_found INTO DATA(lx_nf).
      MESSAGE lx_nf->get_text( ) TYPE 'E'.
    CATCH cx_salv_msg INTO DATA(lx_msg).
      MESSAGE lx_msg->get_text( ) TYPE 'E'.
  ENDTRY.

ENDFORM.