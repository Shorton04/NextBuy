METHOD confirm_operation_by_bapi.
  DATA: lt_conf TYPE TABLE OF bapi_pp_conf_t,  "or your BAPI structure
        lv_ok   TYPE abap_bool.

  TRY.
      CALL FUNCTION 'BAPI_PRODORDCONF_CREATE_TT'
        EXPORTING
          orderid = is_data-processororder
        TABLES
          tt_conf = lt_conf.  "Adjust table parameter name

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.

      rv_ok = abap_true.

    CATCH cx_root INTO DATA(lx).
      rv_ok = abap_false.
  ENDTRY.
ENDMETHOD.