*---------------------------------------------------------------------*
* FORM: update_user_status
*---------------------------------------------------------------------*
FORM update_user_status.

  LOOP AT gt_log INTO DATA(ls_log) WHERE light = 'G' OR light = 'Y'.

    DATA: lt_header  TYPE TABLE OF bapi_alm_order_headers_i,
          lt_status  TYPE TABLE OF bapi_alm_order_usrstat,
          lt_methods TYPE TABLE OF bapi_alm_order_method,
          lt_return  TYPE TABLE OF bapiret2,
          ls_return  TYPE bapiret2,
          lv_action  TYPE string,
          lv_msgtxt  TYPE string.

    IF p_reset = abap_true.
      lv_action = 'RESET'.
    ELSE.
      lv_action = 'SET'.
    ENDIF.

    APPEND VALUE #( orderid = ls_log-aufnr ) TO lt_header.

    IF lv_action = 'SET'.
      APPEND VALUE #( user_st_text = 'KCMP' langu = p_spras ) TO lt_status.
    ELSE.
      APPEND VALUE #( user_st_text = 'KCMP' inactive = abap_true langu = p_spras ) TO lt_status.
    ENDIF.

    APPEND VALUE #( refnumber = '00001' objecttype = 'HEADER' method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00002' objecttype = 'USERSTATUS' method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00003' objecttype = 'ORDER' method = 'SAVE' objectkey = ls_log-aufnr ) TO lt_methods.

    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES
        it_header     = lt_header
        it_methods    = lt_methods
        it_userstatus = lt_status
        return        = lt_return.

    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      ls_log-msgtxt = ls_return-message.
      ls_log-light  = 'R'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      IF lv_action = 'SET'.
        MESSAGE s001(ZA2R_KCMPMSG) INTO lv_msgtxt.
      ELSE.
        MESSAGE s002(ZA2R_KCMPMSG) INTO lv_msgtxt.
      ENDIF.
      ls_log-msgtxt = lv_msgtxt.
      ls_log-light  = 'G'.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
    ENDIF.

    PERFORM release_locks USING ls_log-aufnr.
    MODIFY gt_log FROM ls_log.

  ENDLOOP.

ENDFORM.

*---------------------------------------------------------------------*
* FORM: display_execution_log
*---------------------------------------------------------------------*
FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns,
        lo_col  TYPE REF TO cl_salv_column.

  IF gt_log IS INITIAL.
    MESSAGE i010(ZA2R_KCMPMSG). "No data available
    EXIT.
  ENDIF.

  LOOP AT gt_log ASSIGNING FIELD-SYMBOL(<fs_log>).
    CASE <fs_log>-light.
      WHEN 'G'. <fs_log>-light = icon_led_green.
      WHEN 'R'. <fs_log>-light = icon_led_red.
      WHEN 'Y'. <fs_log>-light = icon_led_yellow.
      WHEN OTHERS. <fs_log>-light = icon_led_inactive.
    ENDCASE.
  ENDLOOP.

  cl_salv_table=>factory(
    IMPORTING r_salv_table = lo_alv
    CHANGING  t_table      = gt_log ).

  lo_alv->get_functions( )->set_all( abap_true ).
  lo_cols = lo_alv->get_columns( ).
  lo_cols->set_optimize( abap_true ).
  lo_alv->display( ).

ENDFORM.

*---------------------------------------------------------------------*
* FORM: release_locks
*---------------------------------------------------------------------*
FORM release_locks USING p_aufnr TYPE aufk-aufnr.

  DATA: lv_fm_used TYPE funcname VALUE space,
        lt_fms     TYPE TABLE OF funcname,
        lv_fm      TYPE funcname,
        lv_exists  TYPE funcname.

  DATA: lv_aufnr    TYPE aufk-aufnr,
        lv_rsnum    TYPE resb-rsnum,
        lv_prueflos TYPE qals-prueflos,
        lv_qmnum    TYPE qmel-qmnum,
        lv_objnr    TYPE jest-objnr.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING input = p_aufnr
    IMPORTING output = lv_aufnr.

  SELECT SINGLE rsnum INTO @lv_rsnum FROM resb WHERE aufnr = @lv_aufnr AND xloek = @space.
  SELECT SINGLE prueflos INTO @lv_prueflos FROM qals WHERE aufnr = @lv_aufnr.
  SELECT SINGLE qmnum INTO @lv_qmnum FROM qmel WHERE aufnr = @lv_aufnr.

  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

  lt_fms = VALUE #(
    ( 'DEQUEUE_EAUFK' )
    ( 'DEQUEUE_EAFKO' )
    ( 'DEQUEUE_EAFVC' )
    ( 'DEQUEUE_EEQUI' )
    ( 'DEQUEUE_EIFLOT' )
    ( 'DEQUEUE_ERESB' )
    ( 'DEQUEUE_ERKPF' )
    ( 'DEQUEUE_EQALS' )
    ( 'DEQUEUE_EQMEL' )
  ).

  LOOP AT lt_fms INTO lv_fm.
    SELECT SINGLE funcname INTO lv_exists FROM tfdir WHERE funcname = lv_fm.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    TRY.
        CASE lv_fm.
          WHEN 'DEQUEUE_EAUFK' OR 'DEQUEUE_EAFKO'.
            CALL FUNCTION lv_fm EXPORTING aufnr = lv_aufnr.
          WHEN 'DEQUEUE_EAFVC'.
            CALL FUNCTION lv_fm EXPORTING objnr = lv_objnr.
          WHEN 'DEQUEUE_ERESB' OR 'DEQUEUE_ERKPF'.
            IF lv_rsnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING rsnum = lv_rsnum.
            ENDIF.
          WHEN 'DEQUEUE_EQALS'.
            IF lv_prueflos IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING prueflos = lv_prueflos.
            ENDIF.
          WHEN 'DEQUEUE_EQMEL'.
            IF lv_qmnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING qmnum = lv_qmnum.
            ENDIF.
        ENDCASE.
      CATCH cx_root INTO DATA(lx_root).
        CONTINUE.
    ENDTRY.
  ENDLOOP.

  CALL FUNCTION 'DEQUEUE_ALL'.
  MESSAGE i013(ZA2R_KCMPMSG) WITH lv_aufnr.

ENDFORM.