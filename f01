METHOD parse_payload.
  DATA(lv_json) TYPE string.
  lv_json = i_payload.  "Convert CHAR → STRING

  TRY.
      /ui2/cl_json=>deserialize(
        EXPORTING
          json = lv_json
        CHANGING
          data = es_data
      ).
    CATCH cx_root INTO DATA(lx).
      RAISE EXCEPTION lx. " re-raise caught exception
  ENDTRY.
ENDMETHOD.


