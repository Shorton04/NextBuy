FORM evaluate_kitting.

  CLEAR gt_log.

  "--------------------------------------------------------------*
  " Single optimized read: AUFK + AFKO join
  "--------------------------------------------------------------*
  SELECT a~aufnr,
         a~auart,
         a~iwerk,
         a~erdat,
         b~gstrp,
         b~gltrp
    FROM aufk AS a
    INNER JOIN afko AS b
      ON a~aufnr = b~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND a~iwerk IN @s_iwerk
      AND a~erdat IN @s_erdat
      AND b~gstrp IN @s_gstrp
      AND b~gltrp IN @s_gltrp
    INTO TABLE @DATA(lt_orders).

  IF lt_orders IS INITIAL.
    MESSAGE 'No matching orders found.' TYPE 'I'.
    EXIT.
  ENDIF.

  "--------------------------------------------------------------*
  " Evaluate component completeness (still needs RESB check)
  "--------------------------------------------------------------*
  SELECT aufnr, SUM( CASE WHEN enmng < bdmng THEN 1 ELSE 0 END ) AS incomplete
    FROM resb
    WHERE aufnr IN @lt_orders
      AND xloek = @space
    GROUP BY aufnr
    INTO TABLE @DATA(lt_resb).

  LOOP AT lt_orders INTO DATA(ls_ord).

    READ TABLE lt_resb INTO DATA(ls_resb)
      WITH KEY aufnr = ls_ord-aufnr.

    CLEAR gs_log.
    MOVE-CORRESPONDING ls_ord TO gs_log.

    IF ls_resb-incomplete > 0.
      gs_log-msgtxt = 'Incomplete components'.
      gs_log-light  = icon_led_red.
    ELSE.
      gs_log-msgtxt = 'Kitting complete'.
      gs_log-light  = icon_led_green.
    ENDIF.

    APPEND gs_log TO gt_log.

  ENDLOOP.

ENDFORM.