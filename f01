*---------------------------------------------------------------------*
* FORM: update_user_status
*---------------------------------------------------------------------*
FORM update_user_status.

  LOOP AT gt_log INTO DATA(ls_log) WHERE light = 'G' OR light = 'Y'.

    DATA: lt_header  TYPE TABLE OF bapi_alm_order_headers_i,
          lt_status  TYPE TABLE OF bapi_alm_order_usrstat,
          lt_methods TYPE TABLE OF bapi_alm_order_method,
          lt_return  TYPE TABLE OF bapiret2,
          ls_return  TYPE bapiret2,
          lv_action  TYPE string.

    "--------------------------------------------------------------*
    " Determine Action: SET or RESET
    "--------------------------------------------------------------*
    IF p_reset = abap_true.
      lv_action = 'RESET'.
    ELSE.
      lv_action = 'SET'.
    ENDIF.

    "--------------------------------------------------------------*
    " Prepare Header & Status Tables
    "--------------------------------------------------------------*
    APPEND VALUE #( orderid = ls_log-aufnr ) TO lt_header.

    IF lv_action = 'SET'.
      APPEND VALUE #( user_st_text = 'KCMP' langu = p_spras ) TO lt_status.
    ELSE.
      APPEND VALUE #( user_st_text = 'KCMP' inactive = abap_true langu = p_spras ) TO lt_status.
    ENDIF.

    "--------------------------------------------------------------*
    " Define Methods
    "--------------------------------------------------------------*
    APPEND VALUE #( refnumber = '00001' objecttype = 'HEADER'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00002' objecttype = 'USERSTATUS'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00003' objecttype = 'ORDER'
                    method = 'SAVE' objectkey = ls_log-aufnr ) TO lt_methods.

    "--------------------------------------------------------------*
    " Execute BAPI
    "--------------------------------------------------------------*
    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES
        it_header     = lt_header
        it_methods    = lt_methods
        it_userstatus = lt_status
        return        = lt_return.

    "--------------------------------------------------------------*
    " Analyze Return Messages
    "--------------------------------------------------------------*
    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.

    IF sy-subrc = 0.
      ls_log-msgtxt = ls_return-message.
      ls_log-light  = 'R'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

    ELSE.
      IF lv_action = 'SET'.
        ls_log-msgtxt = |KCMP set successfully (E0001)|.
      ELSE.
        ls_log-msgtxt = |KCMP reset successfully (E0002)|.
      ENDIF.

      ls_log-light = 'G'.

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.
    ENDIF.

    "--------------------------------------------------------------*
    " Release Locks
    "--------------------------------------------------------------*
    PERFORM release_locks USING ls_log-aufnr.

    MODIFY gt_log FROM ls_log.

  ENDLOOP.

ENDFORM.