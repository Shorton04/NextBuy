*---------------------------------------------------------------------*
* FORM display_execution_log
* Shows ALV of order results with traffic light icons (G/R)
*---------------------------------------------------------------------*
FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns,
        lo_col  TYPE REF TO cl_salv_column,
        lx_msg  TYPE REF TO cx_salv_msg,
        lx_nf   TYPE REF TO cx_salv_not_found.

  IF gt_log IS INITIAL.
    MESSAGE 'No data available to display.' TYPE 'I'.
    EXIT.
  ENDIF.

  " Convert 'G'/'R' to LED icons for SALV display
  LOOP AT gt_log ASSIGNING FIELD-SYMBOL(<fs_log>).
    CASE <fs_log>-light.
      WHEN 'G'. <fs_log>-light = icon_led_green.
      WHEN 'R'. <fs_log>-light = icon_led_red.
      WHEN OTHERS. <fs_log>-light = icon_led_inactive.
    ENDCASE.
  ENDLOOP.

  TRY.
      cl_salv_table=>factory(
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table      = gt_log ).

      lo_alv->get_functions( )->set_all( abap_true ).
      lo_cols = lo_alv->get_columns( ).
      lo_cols->set_optimize( abap_true ).

      " Column headers
      TRY.
          lo_col = lo_cols->get_column( 'AUFNR' ).
          lo_col->set_medium_text( 'Order' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'AUART' ).
          lo_col->set_medium_text( 'Order Type' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'IWERK' ).
          lo_col->set_medium_text( 'Plant' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'ERDAT' ).
          lo_col->set_medium_text( 'Created On' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'GSTRP' ).
          lo_col->set_medium_text( 'Basic Start' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'GLTRP' ).
          lo_col->set_medium_text( 'Basic Finish' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'MSGTXT' ).
          lo_col->set_medium_text( 'Status Message' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      TRY.
          lo_col = lo_cols->get_column( 'LIGHT' ).
          lo_col->set_medium_text( 'Result' ).
        CATCH cx_salv_not_found.
      ENDTRY.

      lo_alv->display( ).

    CATCH cx_salv_not_found INTO lx_nf.
      MESSAGE lx_nf->get_text( ) TYPE 'I'.
    CATCH cx_salv_msg INTO lx_msg.
      MESSAGE lx_msg->get_text( ) TYPE 'I'.
  ENDTRY.

ENDFORM.




*---------------------------------------------------------------------*
* FORM evaluate_kitting
* Purpose : Evaluate completeness of order components
* Logic   : If all RESB-ENMNG >= RESB-BDMNG → Green
*            Else → Red
* PDF     : Only two colors (Green = Ready, Red = Incomplete)
*---------------------------------------------------------------------*
FORM evaluate_kitting.

  DATA: lt_status TYPE TABLE OF lty_log,
        lt_incomplete TYPE TABLE OF aufk-aufnr.

  "--------------------------------------------------------------*
  " 1. Find orders with incomplete components (single SQL JOIN)
  "--------------------------------------------------------------*
  SELECT DISTINCT r~aufnr
    FROM resb AS r
    INNER JOIN aufk AS a ON a~aufnr = r~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND r~xloek = @space
      AND r~enmng < r~bdmng
    INTO TABLE @lt_incomplete.

  "--------------------------------------------------------------*
  " 2. Assign traffic light and message based on completeness
  "--------------------------------------------------------------*
  LOOP AT gt_orders INTO DATA(ls_order).

    READ TABLE lt_incomplete WITH KEY aufnr = ls_order-aufnr TRANSPORTING NO FIELDS.

    IF sy-subrc = 0.
      " Incomplete components
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = 'Incomplete components'
                      light  = 'R' ) TO gt_log.
    ELSE.
      " Ready to set KCMP
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = 'Ready to set KCMP'
                      light  = 'G' ) TO gt_log.
    ENDIF.

  ENDLOOP.

ENDFORM.