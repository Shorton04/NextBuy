*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.

  DATA: lt_incomplete TYPE TABLE OF aufk-aufnr,
        lv_kcmp_active TYPE abap_bool,
        lv_estat TYPE jest-stat.

  "--------------------------------------------------------------*
  " 1. Find orders with incomplete components
  "--------------------------------------------------------------*
  SELECT DISTINCT r~aufnr
    FROM resb AS r
    INNER JOIN aufk AS a ON a~aufnr = r~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND r~xloek = @space
      AND r~enmng < r~bdmng
    INTO TABLE @lt_incomplete.

  "--------------------------------------------------------------*
  " 2. Assign traffic light and message based on completeness
  "--------------------------------------------------------------*
  LOOP AT gt_orders INTO DATA(ls_order).

    " --- Check if KCMP status is already active in JEST
    CLEAR lv_kcmp_active.
    SELECT SINGLE stat
      INTO @lv_estat
      FROM jest
      WHERE objnr = @ls_order-objnr
        AND inact = @space
        AND stat = @gc_estat.

    IF sy-subrc = 0.
      lv_kcmp_active = abap_true.
    ENDIF.

    READ TABLE lt_incomplete WITH KEY aufnr = ls_order-aufnr TRANSPORTING NO FIELDS.

    IF lv_kcmp_active = abap_true.
      " KCMP already set
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = 'KCMP already active'
                      light  = 'Y' ) TO gt_log.

    ELSEIF sy-subrc = 0.
      " Incomplete components
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = 'Incomplete components'
                      light  = 'R' ) TO gt_log.

    ELSE.
      " Ready to set KCMP
      APPEND VALUE #( aufnr  = ls_order-aufnr
                      auart  = ls_order-auart
                      iwerk  = ls_order-iwerk
                      erdat  = ls_order-erdat
                      gstrp  = ls_order-gstrp
                      gltrp  = ls_order-gltrp
                      msgtxt = 'Ready to set KCMP'
                      light  = 'G' ) TO gt_log.
    ENDIF.

  ENDLOOP.

ENDFORM.