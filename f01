*---------------------------------------------------------------------*
* FORM: init_defaults
*---------------------------------------------------------------------*
FORM init_defaults.
  gv_user = sy-uname.
  gv_now  = sy-datum.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: get_kcmp_status
*---------------------------------------------------------------------*
FORM get_kcmp_status.
  DATA: lv_stsma TYPE jsto-stsma,
        lv_aufnr TYPE aufk-aufnr,
        lv_objnr TYPE jest-objnr.

  READ TABLE s_aufnr INDEX 1 INTO DATA(ls_range).
  IF sy-subrc <> 0 OR ls_range-low IS INITIAL.
    MESSAGE 'Please enter at least one Order Number.' TYPE 'E'.
  ENDIF.

  lv_aufnr = ls_range-low.
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING input = lv_aufnr
    IMPORTING output = lv_aufnr.

  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

  SELECT SINGLE stsma
    INTO @lv_stsma
    FROM jsto
    WHERE objnr = @lv_objnr.

  IF sy-subrc <> 0 OR lv_stsma IS INITIAL.
    MESSAGE |Cannot determine status profile for order { lv_aufnr }.| TYPE 'E'.
  ENDIF.

  SELECT SINGLE j~estat
    INTO @gc_estat
    FROM tj30 AS j
    INNER JOIN tj30t AS t
      ON j~estat = t~estat
     AND j~stsma = t~stsma
   WHERE j~stsma = @lv_stsma
     AND t~txt04 = 'KCMP'
     AND t~spras = @sy-langu.

  IF sy-subrc <> 0.
    MESSAGE |KCMP user status not found for profile { lv_stsma } and language { sy-langu }.| TYPE 'E'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: validate_selection
*---------------------------------------------------------------------*
FORM validate_selection.
  IF s_aufnr[] IS INITIAL AND s_iwerk[] IS INITIAL.
    MESSAGE 'Please enter at least one order or plant.' TYPE 'E'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: fetch_orders
*---------------------------------------------------------------------*
FORM fetch_orders.
  CLEAR gt_orders.

  SELECT a~aufnr,
         a~auart,
         b~iwerk,
         a~erdat,
         c~gstrp,
         c~gltrp,
         a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND b~iwerk IN @s_iwerk
    INTO TABLE @gt_orders.

  IF gt_orders IS INITIAL.
    MESSAGE 'No orders found for selection criteria.' TYPE 'I'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_by_jest
*---------------------------------------------------------------------*
FORM filter_by_jest.
  DATA: lt_objnrs       TYPE TABLE OF jest-objnr,
        lt_jest_all     TYPE TABLE OF jest,
        lt_keep         TYPE STANDARD TABLE OF lty_order WITH EMPTY KEY.

  LOOP AT gt_orders INTO DATA(ls_ord).
    APPEND ls_ord-objnr TO lt_objnrs.
  ENDLOOP.

  IF lt_objnrs IS INITIAL.
    gt_orders = VALUE #( ).
    EXIT.
  ENDIF.

  SELECT objnr, stat
    FROM jest
    WHERE objnr IN @lt_objnrs
      AND inact = @space
    INTO TABLE @lt_jest_all.

  LOOP AT gt_orders INTO DATA(ls_ord2).
    DATA(lv_include) = abap_true.
    DATA(lv_has_included) = abap_false.

    LOOP AT lt_jest_all INTO DATA(ls_jst) WHERE objnr = ls_ord2-objnr.
      " --- Exclude statuses
      READ TABLE s_statex WITH KEY low = ls_jst-stat TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        lv_include = abap_false.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_include = abap_false.
      CONTINUE.
    ENDIF.

    LOOP AT lt_jest_all INTO ls_jst WHERE objnr = ls_ord2-objnr.
      READ TABLE s_statin WITH KEY low = ls_jst-stat TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        lv_has_included = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_has_included = abap_true.
      APPEND ls_ord2 TO lt_keep.
    ENDIF.
  ENDLOOP.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_has_components
*---------------------------------------------------------------------*
FORM filter_has_components.
  DATA: lt_resb_exist TYPE TABLE OF resb-aufnr,
        lt_keep       TYPE STANDARD TABLE OF lty_order WITH EMPTY KEY.

  SELECT DISTINCT aufnr
    FROM resb
    WHERE aufnr IN @gt_orders[ aufnr ]
      AND xloek = @space
    INTO TABLE @lt_resb_exist.

  DATA(ht_resb_exist) = VALUE HASHED TABLE OF resb-aufnr
                          WITH UNIQUE KEY table_line
                          ( FOR wa IN lt_resb_exist ( wa ) ).

  LOOP AT gt_orders INTO DATA(ls_ord).
    READ TABLE ht_resb_exist WITH KEY table_line = ls_ord-aufnr TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      APPEND ls_ord TO lt_keep.
    ENDIF.
  ENDLOOP.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.
  TYPES: BEGIN OF ty_resb_sum,
           aufnr         TYPE resb-aufnr,
           total_req     TYPE resb-bdmng,
           total_issued  TYPE resb-enmng,
         END OF ty_resb_sum.

  DATA: lt_resb_summary TYPE STANDARD TABLE OF ty_resb_sum,
        lt_log_local    TYPE STANDARD TABLE OF lty_log WITH EMPTY KEY.

  SELECT aufnr,
         SUM( bdmng ) AS total_req,
         SUM( enmng ) AS total_issued
    FROM resb
    WHERE aufnr IN @gt_orders[ aufnr ]
      AND xloek = @space
    GROUP BY aufnr
    INTO TABLE @lt_resb_summary.

  DATA(ht_resb_summary) = VALUE HASHED TABLE OF ty_resb_sum
                            WITH UNIQUE KEY aufnr
                            ( FOR wa IN lt_resb_summary ( wa ) ).

  LOOP AT gt_orders INTO DATA(ls_ord).
    READ TABLE ht_resb_summary INTO DATA(ls_sum) WITH KEY aufnr = ls_ord-aufnr.
    DATA(lv_complete) = abap_false.

    IF sy-subrc = 0 AND ls_sum-total_req IS NOT INITIAL
       AND ls_sum-total_issued >= ls_sum-total_req.
      lv_complete = abap_true.
    ENDIF.

    IF lv_complete = abap_true.
      APPEND VALUE #( aufnr = ls_ord-aufnr
                      auart = ls_ord-auart
                      iwerk = ls_ord-iwerk
                      msgtxt = 'Ready to set KCMP'
                      light  = 'Y' ) TO lt_log_local.
    ELSE.
      APPEND VALUE #( aufnr = ls_ord-aufnr
                      auart = ls_ord-auart
                      iwerk = ls_ord-iwerk
                      msgtxt = 'Incomplete components'
                      light  = 'R' ) TO lt_log_local.
    ENDIF.
  ENDLOOP.

  gt_log = lt_log_local.
ENDFORM.

