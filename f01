FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_START_COL) TYPE  I DEFAULT 25
*"     REFERENCE(IV_START_LINE) TYPE  I DEFAULT 6
*"     REFERENCE(IV_END_COL) TYPE  I DEFAULT 120
*"     REFERENCE(IV_END_LINE) TYPE  I DEFAULT 25
*"     REFERENCE(IV_TITLE) TYPE  STRING DEFAULT 'ALV Display'
*"  EXPORTING
*"     REFERENCE(EV_CHOICE) TYPE  FLAG
*"  CHANGING
*"     REFERENCE(IT_TABLE) TYPE  STANDARD TABLE
*"----------------------------------------------------------------------
  DATA: lo_container TYPE REF TO cl_gui_dialogbox_container,
        lo_salv      TYPE REF TO cl_salv_table,
        lo_events    TYPE REF TO cl_salv_events_table,
        lv_answer    TYPE c.

  " Check if GUI is available
  IF NOT cl_gui_alv_grid=>offline( ) IS INITIAL.
    MESSAGE 'No GUI environment found.' TYPE 'E'.
  ENDIF.

  " Create container popup window
  CREATE OBJECT lo_container
    EXPORTING
      caption = iv_title
      top     = iv_start_line
      left    = iv_start_col
      width   = iv_end_col
      height  = iv_end_line.

  " Create SALV table in popup container
  TRY.
      cl_salv_table=>factory(
        EXPORTING
          r_container = lo_container
        IMPORTING
          r_salv_table = lo_salv
        CHANGING
          t_table = it_table ).

      " Allow all ALV functions
      lo_salv->get_functions( )->set_all( abap_true ).
      lo_salv->get_display_settings( )->set_list_header( iv_title ).
      lo_salv->get_display_settings( )->set_striped_pattern( abap_true ).
      lo_salv->get_selections( )->set_selection_mode( if_salv_c_selection_mode=>row_column ).

      " Display ALV
      lo_salv->display( ).

      " Show dialog popup with OK / Cancel
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar              = iv_title
          text_question         = 'Do you want to continue?'
          text_button_1         = 'Yes'
          text_button_2         = 'No'
          default_button        = '1'
        IMPORTING
          answer                = lv_answer.

      IF lv_answer = '1'.
        ev_choice = abap_true.   " Continue pressed
      ELSE.
        ev_choice = abap_false.  " Cancel pressed
      ENDIF.

    CATCH cx_salv_msg INTO DATA(lx_msg).
      MESSAGE lx_msg->get_text( ) TYPE 'E'.
  ENDTRY.

  " Free popup
  IF lo_container IS BOUND.
    CALL METHOD lo_container->free.
  ENDIF.

ENDFUNCTION.