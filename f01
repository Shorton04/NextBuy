*---------------------------------------------------------------------*
* FORM: init_defaults
*---------------------------------------------------------------------*
FORM init_defaults.
  gv_user = sy-uname.
  gv_now  = sy-datum.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: get_kcmp_status (safe & language-dependent)
*---------------------------------------------------------------------*
FORM get_kcmp_status.
  DATA: lv_stsma TYPE jsto-stsma,
        lv_aufnr TYPE aufk-aufnr,
        lv_objnr TYPE jest-objnr.

  " --- Read first order number from selection
  READ TABLE s_aufnr INDEX 1 INTO DATA(ls_range).
  IF sy-subrc <> 0 OR ls_range-low IS INITIAL.
    MESSAGE 'Please enter at least one Order Number.' TYPE 'E'.
  ENDIF.

  " --- Convert order number to internal format
  lv_aufnr = ls_range-low.
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = lv_aufnr
    IMPORTING
      output = lv_aufnr.

  " --- Build OBJNR = 'OR' + padded order number
  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

  " --- Read status profile (STSMA) from JSTO
  SELECT SINGLE stsma
    INTO @lv_stsma
    FROM jsto
    WHERE objnr = @lv_objnr.

  IF sy-subrc <> 0 OR lv_stsma IS INITIAL.
    MESSAGE |Cannot determine status profile for order { lv_aufnr }.| TYPE 'E'.
  ENDIF.

  " --- Get KCMP internal status code (language dependent)
  SELECT SINGLE j~estat
    INTO @gc_estat
    FROM tj30 AS j
      INNER JOIN tj30t AS t
        ON j~estat = t~estat
       AND j~stsma = t~stsma
   WHERE j~stsma = @lv_stsma
     AND t~txt04 = 'KCMP'
     AND t~spras = @sy-langu.

  IF sy-subrc <> 0.
    MESSAGE |KCMP user status not found for profile { lv_stsma } and language { sy-langu }.| TYPE 'E'.
  ENDIF.

ENDFORM.

*---------------------------------------------------------------------*
* FORM: validate_selection
*---------------------------------------------------------------------*
FORM validate_selection.
  IF s_aufnr[] IS INITIAL AND s_iwerk[] IS INITIAL.
    MESSAGE 'Please enter at least one order or plant.' TYPE 'E'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: fetch_orders
*---------------------------------------------------------------------*
FORM fetch_orders.
  CLEAR gt_orders.

  SELECT a~aufnr,
         a~auart,
         b~iwerk,
         a~erdat,
         c~gstrp,
         c~gltrp,
         a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND b~iwerk IN @s_iwerk
    INTO TABLE @gt_orders.

  IF gt_orders IS INITIAL.
    MESSAGE 'No orders found for selection criteria.' TYPE 'I'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_by_jest
*---------------------------------------------------------------------*
FORM filter_by_jest.
  DATA lt_keep TYPE STANDARD TABLE OF lty_order.

  LOOP AT gt_orders INTO DATA(ls_ord).
    SELECT stat
      FROM jest
      WHERE objnr = @ls_ord-objnr
        AND inact = @space
      INTO TABLE @DATA(lt_jest).

    IF lt_jest IS INITIAL.
      CONTINUE.
    ENDIF.

    DATA(lv_include) = abap_true.

    " Exclude statuses in S_STATEX
    LOOP AT lt_jest INTO DATA(ls_stat).
      READ TABLE s_statex WITH KEY low = ls_stat-stat TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        lv_include = abap_false.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_include = abap_true.
      " Must have one of the included statuses
      LOOP AT lt_jest INTO ls_stat WHERE stat IN s_statin.
        APPEND ls_ord TO lt_keep.
        EXIT.
      ENDLOOP.
    ENDIF.
  ENDLOOP.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_has_components
*---------------------------------------------------------------------*
FORM filter_has_components.
  DATA lt_keep TYPE STANDARD TABLE OF lty_order.

  LOOP AT gt_orders INTO DATA(ls_ord).
    SELECT COUNT(*)
      FROM resb
      WHERE aufnr = @ls_ord-aufnr
        AND xloek = @space.
        "AND kzear = @space.
    IF sy-dbcnt > 0.
      APPEND ls_ord TO lt_keep.
    ENDIF.
  ENDLOOP.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.
  DATA: lt_resb         TYPE TABLE OF resb,
        lv_all_complete TYPE abap_bool.

  LOOP AT gt_orders INTO DATA(ls_ord).
    CLEAR: lt_resb, lv_all_complete.
    lv_all_complete = abap_true.

    SELECT * FROM resb
      WHERE aufnr = @ls_ord-aufnr
        AND xloek = @space
        "AND kzear = @space
      INTO TABLE @lt_resb.

    LOOP AT lt_resb INTO DATA(ls_resb).
      IF ls_resb-enmng < ls_resb-bdmng.
        lv_all_complete = abap_false.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_all_complete = abap_true.
      APPEND VALUE #( aufnr = ls_ord-aufnr auart = ls_ord-auart
                      iwerk = ls_ord-iwerk msgtxt = 'Ready to set KCMP' light = 'Y' ) TO gt_log.
    ELSE.
      APPEND VALUE #( aufnr = ls_ord-aufnr auart = ls_ord-auart
                      iwerk = ls_ord-iwerk msgtxt = 'Incomplete components' light = 'R' ) TO gt_log.
    ENDIF.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: check_authorizations
*---------------------------------------------------------------------*
FORM check_authorizations.
  AUTHORITY-CHECK OBJECT 'C_AFKO_ACT' ID 'PS_ACTVT' FIELD '02'.
  IF sy-subrc <> 0.
    MESSAGE 'User not authorized to change orders.' TYPE 'E'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: update_user_status
*---------------------------------------------------------------------*
FORM update_user_status.

  LOOP AT gt_log INTO DATA(ls_log) WHERE light = 'Y'.

    DATA: lt_header  TYPE TABLE OF bapi_alm_order_headers_i,
          lt_status  TYPE TABLE OF bapi_alm_order_usrstat,
          lt_methods TYPE TABLE OF bapi_alm_order_method,
          lt_return  TYPE TABLE OF bapiret2,
          ls_return  TYPE bapiret2,
          lv_action  TYPE string.

    " Determine action mode
    IF p_reset = abap_true.
      lv_action = 'RESET'.
    ELSE.
      lv_action = 'SET'.
    ENDIF.

    APPEND VALUE #( orderid = ls_log-aufnr ) TO lt_header.

    " Set or Reset KCMP status
    IF lv_action = 'SET'.
      APPEND VALUE #( user_st_text = 'KCMP' langu = p_spras ) TO lt_status.
    ELSE.
      " RESET mode: deactivate KCMP (INACT = 'X')
      APPEND VALUE #( user_st_text = 'KCMP' inactive = abap_true langu = p_spras ) TO lt_status.
    ENDIF.

    " BAPI methods for change
    APPEND VALUE #( refnumber = '00001' objecttype = 'HEADER'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00001' objecttype = 'USERSTATUS'
                    method = 'CHANGE' objectkey = ls_log-aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00003' objecttype = 'ORDER'
                    method = 'SAVE' objectkey = ls_log-aufnr ) TO lt_methods.

    " Execute status change
    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES
        it_header     = lt_header
        it_methods    = lt_methods
        it_userstatus = lt_status
        return        = lt_return.

    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      ls_log-msgtxt = ls_return-message(72).
      ls_log-light  = 'R'.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      IF lv_action = 'SET'.
        ls_log-msgtxt = |KCMP set successfully ({ gc_estat })|.
      ELSE.
        ls_log-msgtxt = |KCMP reset successfully ({ gc_estat })|.
      ENDIF.
      ls_log-light  = 'G'.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
    ENDIF.

    PERFORM release_locks USING ls_log-aufnr.
    MODIFY gt_log FROM ls_log.

  ENDLOOP.

  COMMIT WORK.

ENDFORM.

*---------------------------------------------------------------------*
* FORM: display_execution_log
*---------------------------------------------------------------------*
FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns_table,
        lo_col  TYPE REF TO cl_salv_column,
        lo_func TYPE REF TO cl_salv_functions,
        ls_log  TYPE lty_log,
        lx_msg  TYPE REF TO cx_salv_msg,
        lx_nf   TYPE REF TO cx_salv_not_found.

  IF gt_log IS INITIAL.
    MESSAGE 'No orders processed.' TYPE 'I'.
    EXIT.
  ENDIF.

  TRY.
      "--------------------------------------------------------------*
      " Create ALV for the internal table GT_LOG
      "--------------------------------------------------------------*
      CALL METHOD cl_salv_table=>factory
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table      = gt_log.

      "--------------------------------------------------------------*
      " Enable ALV standard functions (export, sort, filter, etc.)
      "--------------------------------------------------------------*
      lo_func = lo_alv->get_functions( ).
      CALL METHOD lo_func->set_all
        EXPORTING
          value = abap_true.

      "--------------------------------------------------------------*
      " Set column headers and descriptions
      "--------------------------------------------------------------*
      lo_cols = lo_alv->get_columns( ).

      " Order number
      CALL METHOD lo_cols->get_column
        EXPORTING
          columnname = 'AUFNR'
        RECEIVING
          value      = lo_col.
      CALL METHOD lo_col->set_short_text EXPORTING value = 'Order'.
      CALL METHOD lo_col->set_medium_text EXPORTING value = 'Order Number'.
      CALL METHOD lo_col->set_long_text EXPORTING value = 'Maintenance Order Number'.

      " Order type
      CALL METHOD lo_cols->get_column
        EXPORTING
          columnname = 'AUART'
        RECEIVING
          value      = lo_col.
      CALL METHOD lo_col->set_short_text EXPORTING value = 'Type'.
      CALL METHOD lo_col->set_medium_text EXPORTING value = 'Order Type'.

      " Plant
      CALL METHOD lo_cols->get_column
        EXPORTING
          columnname = 'IWERK'
        RECEIVING
          value      = lo_col.
      CALL METHOD lo_col->set_short_text EXPORTING value = 'Plant'.
      CALL METHOD lo_col->set_medium_text EXPORTING value = 'Maint. Plant'.

      " Message text
      CALL METHOD lo_cols->get_column
        EXPORTING
          columnname = 'MSGTXT'
        RECEIVING
          value      = lo_col.
      CALL METHOD lo_col->set_short_text EXPORTING value = 'Status'.
      CALL METHOD lo_col->set_medium_text EXPORTING value = 'Component Check'.
      CALL METHOD lo_col->set_long_text EXPORTING value = 'Component Status Message'.

      " Result light
      CALL METHOD lo_cols->get_column
        EXPORTING
          columnname = 'LIGHT'
        RECEIVING
          value      = lo_col.
      CALL METHOD lo_col->set_short_text EXPORTING value = 'R'.
      CALL METHOD lo_col->set_medium_text EXPORTING value = 'Result'.
      CALL METHOD lo_col->set_long_text EXPORTING value = 'Processing Result'.

      "--------------------------------------------------------------*
      " Display ALV
      "--------------------------------------------------------------*
      CALL METHOD lo_alv->display( ).

      "--------------------------------------------------------------*
      " Handle column-not-found or general SALV errors gracefully
      "--------------------------------------------------------------*
    CATCH cx_salv_not_found INTO lx_nf.
      MESSAGE lx_nf->get_text( ) TYPE 'I'.

    CATCH cx_salv_msg INTO lx_msg.
      LOOP AT gt_log INTO ls_log.
        WRITE: / ls_log-aufnr, ls_log-iwerk, ls_log-msgtxt.
      ENDLOOP.
  ENDTRY.

ENDFORM.

*---------------------------------------------------------------------*
* FORM release_locks
*---------------------------------------------------------------------*
FORM release_locks USING p_aufnr TYPE aufk-aufnr.

  DATA: lv_fm_used TYPE funcname VALUE space,
        lt_fms     TYPE TABLE OF funcname,
        lv_fm      TYPE funcname,
        lv_exists  TYPE funcname,
        lv_msg     TYPE char100.

  DATA: lv_aufnr    TYPE aufk-aufnr,
        lv_rsnum    TYPE resb-rsnum,
        lv_prueflos TYPE qals-prueflos,
        lv_qmnum    TYPE qmel-qmnum,
        lv_objnr    TYPE jest-objnr.

  " --- Normalize order number
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = p_aufnr
    IMPORTING
      output = lv_aufnr.

  " --- Related data (for optional unlocks)
  SELECT SINGLE rsnum
    INTO @lv_rsnum
    FROM resb
    WHERE aufnr = @lv_aufnr
      AND xloek = @space.
      "AND kzear = @space.

  SELECT SINGLE prueflos
    INTO @lv_prueflos
    FROM qals
    WHERE aufnr = @lv_aufnr.

  SELECT SINGLE qmnum
    INTO @lv_qmnum
    FROM qmel
    WHERE aufnr = @lv_aufnr.

  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

  " --- Build list of possible DEQUEUE FMs
  lt_fms = VALUE #(
    ( 'DEQUEUE_EAUFK' )   " Order header
    ( 'DEQUEUE_EAFKO' )   " Order master data
    ( 'DEQUEUE_EAFVC' )   " Operations
    ( 'DEQUEUE_EEQUI' )   " Equipment
    ( 'DEQUEUE_EIFLOT' )  " Functional Location
    ( 'DEQUEUE_ERESB' )   " Reservation
    ( 'DEQUEUE_ERKPF' )   " Reservation Header
    ( 'DEQUEUE_EQALS' )   " Inspection lot
    ( 'DEQUEUE_EQMEL' )   " Notification
  ).

  LOOP AT lt_fms INTO lv_fm.

    " --- Skip if FM does not exist in system
    SELECT SINGLE funcname INTO lv_exists
      FROM tfdir
      WHERE funcname = lv_fm.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    TRY.
        CASE lv_fm.
          WHEN 'DEQUEUE_EAUFK' OR 'DEQUEUE_EAFKO'.
            CALL FUNCTION lv_fm EXPORTING aufnr = lv_aufnr.

          WHEN 'DEQUEUE_EAFVC'.
            CALL FUNCTION lv_fm EXPORTING objnr = lv_objnr.

          WHEN 'DEQUEUE_ERESB' OR 'DEQUEUE_ERKPF'.
            IF lv_rsnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING rsnum = lv_rsnum.
            ENDIF.

          WHEN 'DEQUEUE_EQALS'.
            IF lv_prueflos IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING prueflos = lv_prueflos.
            ENDIF.

          WHEN 'DEQUEUE_EQMEL'.
            IF lv_qmnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING qmnum = lv_qmnum.
            ENDIF.
        ENDCASE.

      CATCH cx_root INTO DATA(lx_root).
        CONTINUE.
    ENDTRY.

  ENDLOOP.

  " --- Final safety unlock (clears anything remaining in session)
  CALL FUNCTION 'DEQUEUE_ALL'.

  CONCATENATE 'Locks released for order' lv_aufnr INTO lv_msg SEPARATED BY space.
  WRITE: / lv_msg.

ENDFORM.
