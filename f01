METHOD COPY_REPORT_TO_STRUCT.

* local definition
  DATA: lo_struct_descr       TYPE REF TO cl_abap_structdescr,
        lt_component          TYPE cl_abap_structdescr=>component_table,
        ls_component          TYPE abap_componentdescr,
        lv_struct_field_name  TYPE string,
        lv_report_field_name        TYPE string.

  FIELD-SYMBOLS: <lv_report_field> TYPE ANY,
                 <lv_struct_field> TYPE ANY.

* Assert input
  ASSERT iv_direction = gc_direction_r2s OR iv_direction = gc_direction_s2r.
  ASSERT mv_report_id IS NOT INITIAL.

* copy data

  IF iv_direction = gc_direction_r2s.
    lo_struct_descr ?=  cl_abap_typedescr=>describe_by_data( cs_structure ).
  ELSE.
    lo_struct_descr ?=  cl_abap_typedescr=>describe_by_data( is_structure ).
  ENDIF.

  IF lo_struct_descr IS BOUND.
    " create field catalog from DDIC
    lt_component = lo_struct_descr->get_components( ).

    LOOP AT lt_component INTO ls_component.
      " unassign field symbols
      UNASSIGN <lv_report_field>.
      UNASSIGN <lv_struct_field>.

      " determine structure and report field name
      lv_struct_field_name = ls_component-name.
      TRANSLATE lv_struct_field_name TO UPPER CASE.

      lv_report_field_name = ls_component-name.
      CONCATENATE `(` mv_report_id `)` ls_component-name INTO lv_report_field_name.
      IF ls_component-name(2) = 'r_' OR ls_component-name(2) = 'R_'.
        CONCATENATE lv_report_field_name '[]' INTO lv_report_field_name.
      ENDIF.
      TRANSLATE lv_report_field_name TO UPPER CASE.

      " assign field-symbols
      IF iv_direction = gc_direction_r2s.
        ASSIGN COMPONENT lv_struct_field_name OF STRUCTURE cs_structure TO <lv_struct_field>.
      ELSE.
        ASSIGN COMPONENT lv_struct_field_name OF STRUCTURE is_structure TO <lv_struct_field>.
      ENDIF.
      ASSERT <lv_struct_field> IS ASSIGNED. "this must be okay, as we are in a loop over the components

      ASSIGN (lv_report_field_name) TO <lv_report_field>.
      IF <lv_report_field> IS NOT ASSIGNED.
        " parameter not avaialbe in report; thats okay
        CONTINUE.
      ENDIF.

      " Copy report data to structure or vice versa
      IF iv_direction = gc_direction_r2s.
        <lv_struct_field> = <lv_report_field>.
      ELSEIF  iv_direction = gc_direction_s2r.
        <lv_report_field> = <lv_struct_field>.
      ELSE.
        ASSERT 1 = 2.
        " You need to follow the naming convertions for the report parameters
        " R_ Range tables
        " V_ Parameters
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDMETHOD.
