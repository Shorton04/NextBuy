* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_ZZ1_A2R_CMXCALIBRA_DPC_EXT->/IWBEP/IF_MGW_APPL_SRV_RUNTIME~EXECUTE_ACTION
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_ACTION_NAME                 TYPE        STRING(optional)
* | [--->] IT_PARAMETER                   TYPE        /IWBEP/T_MGW_NAME_VALUE_PAIR(optional)
* | [--->] IO_TECH_REQUEST_CONTEXT        TYPE REF TO /IWBEP/IF_MGW_REQ_FUNC_IMPORT(optional)
* | [<---] ER_DATA                        TYPE REF TO DATA
* | [!CX!] /IWBEP/CX_MGW_BUSI_EXCEPTION
* | [!CX!] /IWBEP/CX_MGW_TECH_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD /iwbep/if_mgw_appl_srv_runtime~execute_action.
    DATA: ls_result TYPE zcl_zz1_a2r_cmxcalibra_mpc=>ts_returnmessage.
    DATA: lt_header  TYPE TABLE OF bapi_alm_order_headers_i,
          lt_status  TYPE TABLE OF bapi_alm_order_usrstat,
          lt_methods TYPE TABLE OF bapi_alm_order_method,
          lt_return  TYPE TABLE OF bapiret2,
          lr_status  TYPE /mfnd/core_range_tab,
          lv_stat    TYPE j_status,
          ls_return  TYPE bapiret2.

    CASE iv_action_name.
      WHEN 'MaintainOrder'.
        DATA(lv_order) = VALUE aufnr( it_parameter[ name = 'MaintenanceOrder' ]-value OPTIONAL ).
        DATA(lv_status) = VALUE j_txt04( it_parameter[ name = 'Status' ]-value OPTIONAL ).
        IF lv_order IS NOT INITIAL AND lv_status IS NOT INITIAL.
          CLEAR: lt_header, lt_status, lt_methods, lt_return.
          APPEND VALUE #( orderid = |{ lv_order ALPHA = IN }| ) TO lt_header.
          APPEND VALUE #( user_st_text = lv_status langu = sy-langu ) TO lt_status.
          APPEND VALUE #( refnumber = '00001' objecttype = 'HEADER' method = 'CHANGE'
                          objectkey = lv_order ) TO lt_methods.
          APPEND VALUE #( refnumber = '00001' objecttype = 'USERSTATUS' method = 'CHANGE'
                          objectkey = lv_order ) TO lt_methods.
          APPEND VALUE #( refnumber = '00003' objecttype = 'ORDER' method = 'SAVE'
                          objectkey = lv_order ) TO lt_methods.
          CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
            TABLES
              it_header     = lt_header
              it_methods    = lt_methods
              it_userstatus = lt_status
              return        = lt_return.
          READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
          IF sy-subrc = 0.
            ls_result = ls_return.
            CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
          ELSE.
            CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
              EXPORTING
                wait = 'X'.
          ENDIF.
        ENDIF.
      WHEN 'MaintainNotif'.
        DATA(lv_notifno) = VALUE qmnum( it_parameter[ name = 'NotificationOrder' ]-value OPTIONAL  ).
        lv_notifno = |{ lv_notifno ALPHA = IN }|.
        DATA(lv_extstat) = VALUE j_txt04( it_parameter[ name = 'Status' ]-value OPTIONAL ).
        IF lv_notifno IS NOT INITIAL AND
          lv_extstat IS NOT INITIAL.
          CALL FUNCTION 'BAPI_ALM_NOTIF_CHANGEUSRSTAT'
            EXPORTING
              number     = lv_notifno
              usr_status = VALUE bapi2080_notusrstati( status_int = 'E0004'
                                                       status_ext = lv_extstat
                                                       langu = sy-langu
                                                       langu_iso = sy-langu )
            TABLES
              return     = lt_return.
          READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
          IF sy-subrc = 0.
            ls_result = ls_return.
            CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
          ELSE.
            CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
              EXPORTING
                wait = 'X'.
          ENDIF.
        ENDIF.
      WHEN 'ChangeObjStatus'.

        DATA(lv_objnr) = VALUE qmobjnr( it_parameter[ name = 'ObjectNumber' ]-value OPTIONAL ).
        DATA(lv_ustat) = VALUE j_status( it_parameter[ name = 'Status' ]-value OPTIONAL ).

        IF lv_objnr IS NOT INITIAL AND
          lv_ustat IS NOT INITIAL.
          lr_status = VALUE #( sign = 'I' option = 'EQ' ( low = 'E0001' )
                                                        ( low = 'E0003' )
                                                        ( low = lv_ustat ) ).
          LOOP AT lr_status INTO DATA(ls_status).

            lv_stat = ls_status-low.
            IF ls_status-low = lv_ustat.
              DATA(lv_inact) = abap_false.
            ELSE.
              lv_inact = abap_true.
            ENDIF.

            CALL FUNCTION 'STATUS_CHANGE_EXTERN'
              EXPORTING
                objnr               = lv_objnr
                user_status         = lv_stat
                set_inact           = lv_inact
              EXCEPTIONS
                object_not_found    = 1
                status_inconsistent = 2
                status_not_allowed  = 3
                OTHERS              = 4.
            IF sy-subrc <> 0.
              ls_result-type = sy-msgty.
              ls_result-id = sy-msgid.
              ls_result-number = sy-msgno.
            ELSE.
              COMMIT WORK.
            ENDIF.
          ENDLOOP.
        ENDIF.
    ENDCASE.
    copy_data_to_ref( EXPORTING is_data = ls_result CHANGING cr_data = er_data ).
  ENDMETHOD.
ENDCLASS.
