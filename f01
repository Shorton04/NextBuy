FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(iv_start_col)  TYPE i DEFAULT 25
*"     VALUE(iv_start_line) TYPE i DEFAULT 6
*"     VALUE(iv_end_col)    TYPE i DEFAULT 100
*"     VALUE(iv_end_line)   TYPE i DEFAULT 10
*"     VALUE(iv_title)      TYPE string DEFAULT 'ALV'
*"     VALUE(it_field_names) TYPE STANDARD TABLE OPTIONAL
*"  CHANGING
*"     VALUE(it_table) TYPE STANDARD TABLE OPTIONAL
*"  EXPORTING
*"     VALUE(ev_choice) TYPE flag
*"----------------------------------------------------------------------
  DATA: lo_popup  TYPE REF TO cl_reca_gui_f4_popup,
        lt_names  TYPE STANDARD TABLE OF zzs_alv_popup_names,
        ls_names  TYPE zzs_alv_popup_names,
        lv_cancel TYPE abap_bool,
        lt_result TYPE STANDARD TABLE OF string.

  IF it_table IS INITIAL.
    RETURN.
  ENDIF.

  " Create popup instance
  CALL METHOD cl_reca_gui_f4_popup=>factory_grid
    EXPORTING
      it_f4value     = it_table
      if_multi       = abap_false
      id_title       = iv_title
    RECEIVING
      ro_f4_instance = lo_popup.

  CHECK lo_popup IS BOUND.

  MOVE-CORRESPONDING it_field_names TO lt_names.

  LOOP AT lt_names INTO ls_names.
    CALL METHOD lo_popup->set_field_text
      EXPORTING
        id_fieldname = ls_names-fieldname
        id_text      = ls_names-heading.
  ENDLOOP.

  " Add a custom OK (Check) button to the popup
  lo_popup->mo_alv_grid->set_toolbar_interactive( abap_true ).
  lo_popup->mo_alv_grid->register_edit_event( cl_gui_alv_grid=>mc_evt_modified ).

  " Add the OK button (green check)
  DATA(lo_toolbar) = lo_popup->mo_alv_grid->get_frontend_services( ).
  lo_toolbar->add_toolbar_button(
      i_function = 'OK'
      i_icon     = icon_okay
      i_text     = 'Check'
      i_quickinfo = 'Confirm and Continue' ).

  " Display popup
  CALL METHOD lo_popup->display
    EXPORTING
      id_start_column    = iv_start_col
      id_start_line      = iv_start_line
      id_end_column      = iv_end_col
      id_end_line        = iv_end_line
      if_send_cancel_msg = abap_false
    IMPORTING
      et_result          = lt_result
      ef_cancelled       = lv_cancel.

  " Handle user choice
  IF lv_cancel = abap_true.
    ev_choice = abap_false.
  ELSE.
    IF lt_result IS NOT INITIAL.
      it_table = lt_result.
    ENDIF.
    ev_choice = abap_true.
  ENDIF.

ENDFUNCTION.