FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(iv_start_col) TYPE i DEFAULT 25
*"     REFERENCE(iv_start_line) TYPE i DEFAULT 6
*"     REFERENCE(iv_end_col)   TYPE i DEFAULT 120
*"     REFERENCE(iv_end_line)  TYPE i DEFAULT 25
*"     REFERENCE(iv_title)     TYPE string DEFAULT 'ALV Display'
*"  EXPORTING
*"     REFERENCE(ev_choice)    TYPE flag
*"  CHANGING
*"     REFERENCE(it_table)     TYPE STANDARD TABLE OPTIONAL
*"----------------------------------------------------------------------

  DATA: lo_container  TYPE REF TO cl_gui_dialogbox_container,
        lo_salv       TYPE REF TO cl_salv_table,
        lv_caption_s  TYPE string,            " for SALV / popup functions
        lv_caption_c  TYPE c LENGTH 80,      " for dialog container caption
        lv_answer     TYPE c.

  FIELD-SYMBOLS: <fs_table> TYPE STANDARD TABLE.

  IF it_table IS INITIAL.
    RETURN.
  ENDIF.

  " assign incoming title to string caption
  lv_caption_s = iv_title.

  " create a CHAR(80) version for container - truncate/pad as needed
  lv_caption_c = lv_caption_s.
  " If lv_caption_s longer than 80 it will be truncated when assigned to C(80)

  " Create popup container for ALV - PASS CHAR caption
  CREATE OBJECT lo_container
    EXPORTING
      caption = lv_caption_c
      top     = iv_start_line
      left    = iv_start_col
      width   = iv_end_col
      height  = iv_end_line.

  TRY.
      " Create SALV table inside popup container
      CALL METHOD cl_salv_table=>factory
        EXPORTING
          r_container = lo_container
        IMPORTING
          r_salv_table = lo_salv
        CHANGING
          t_table      = it_table.

      " Enable ALV features
      CALL METHOD lo_salv->get_functions( )->set_all
        EXPORTING
          value = abap_true.

      " Use string caption for SALV display header (pass string)
      CALL METHOD lo_salv->get_display_settings( )->set_list_header
        EXPORTING
          value = lv_caption_s.

      CALL METHOD lo_salv->get_display_settings( )->set_striped_pattern
        EXPORTING
          value = abap_true.

      " Optional: allow row selection (single/multi)
      CALL METHOD lo_salv->get_selections( )->set_selection_mode
        EXPORTING
          value = if_salv_c_selection_mode=>row_column.

      " Display ALV in the container
      CALL METHOD lo_salv->display.

      " Wait & ask confirmation (use string caption for popup titlebar)
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar       = lv_caption_s
          text_question  = 'Do you want to continue?'
          text_button_1  = 'Yes'
          text_button_2  = 'No'
          default_button = '1'
        IMPORTING
          answer         = lv_answer.

      IF lv_answer = '1'.
        ev_choice = abap_true.
      ELSE.
        ev_choice = abap_false.
      ENDIF.

    CATCH cx_salv_msg INTO DATA(lx_salv).
      MESSAGE lx_salv->get_text( ) TYPE 'E'.
  ENDTRY.

  " Free container
  IF lo_container IS BOUND.
    CALL METHOD lo_container->free.
  ENDIF.

ENDFUNCTION.