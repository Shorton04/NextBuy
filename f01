FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(iv_start_col) TYPE i DEFAULT 25
*"     REFERENCE(iv_start_line) TYPE i DEFAULT 6
*"     REFERENCE(iv_end_col)   TYPE i DEFAULT 120
*"     REFERENCE(iv_end_line)  TYPE i DEFAULT 25
*"     REFERENCE(iv_title)     TYPE c DEFAULT 'ALV Display'
*"  EXPORTING
*"     REFERENCE(ev_choice)    TYPE flag
*"  CHANGING
*"     REFERENCE(it_table)     TYPE STANDARD TABLE OPTIONAL
*"----------------------------------------------------------------------

  DATA: lo_container TYPE REF TO cl_gui_dialogbox_container,
        lo_salv      TYPE REF TO cl_salv_table,
        lv_answer    TYPE c,
        lv_caption   TYPE c LENGTH 80.

  " Convert safely, no CONV() usage for older ABAP versions
  lv_caption = iv_title.

  " Create container popup window
  CREATE OBJECT lo_container
    EXPORTING
      caption = lv_caption
      top     = iv_start_line
      left    = iv_start_col
      width   = iv_end_col
      height  = iv_end_line.

  TRY.
      " Create SALV table
      cl_salv_table=>factory(
        EXPORTING
          r_container = lo_container
        IMPORTING
          r_salv_table = lo_salv
        CHANGING
          t_table = it_table ).

      " Enable ALV features
      lo_salv->get_functions( )->set_all( abap_true ).
      lo_salv->get_display_settings( )->set_list_header( lv_caption ).
      lo_salv->get_display_settings( )->set_striped_pattern( abap_true ).
      lo_salv->get_selections( )->set_selection_mode( if_salv_c_selection_mode=>row_column ).

      lo_salv->display( ).

      " Confirmation popup after viewing
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar      = lv_caption
          text_question = 'Do you want to continue?'
          text_button_1 = 'Yes'
          text_button_2 = 'No'
          default_button = '1'
        IMPORTING
          answer = lv_answer.

      IF lv_answer = '1'.
        ev_choice = abap_true.
      ELSE.
        ev_choice = abap_false.
      ENDIF.

    CATCH cx_salv_msg INTO DATA(lx_msg).
      MESSAGE lx_msg->get_text( ) TYPE 'E'.
  ENDTRY.

  " Clean up
  IF lo_container IS BOUND.
    lo_container->free( ).
  ENDIF.

ENDFUNCTION.