FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_START_COL)  TYPE  I DEFAULT 25
*"     REFERENCE(IV_START_LINE) TYPE  I DEFAULT 6
*"     REFERENCE(IV_END_COL)    TYPE  I DEFAULT 100
*"     REFERENCE(IV_END_LINE)   TYPE  I DEFAULT 20
*"     REFERENCE(IV_TITLE)      TYPE  STRING DEFAULT 'ALV'
*"     REFERENCE(IT_FIELD_NAMES) TYPE STANDARD TABLE OPTIONAL
*"  EXPORTING
*"     REFERENCE(EV_CHOICE) TYPE FLAG
*"  CHANGING
*"     REFERENCE(IT_TABLE)  TYPE STANDARD TABLE OPTIONAL
*"----------------------------------------------------------------------

  DATA: lo_container   TYPE REF TO cl_gui_dialogbox_container,
        lo_alv         TYPE REF TO cl_salv_table,
        lo_display     TYPE REF TO cl_salv_display_settings,
        lo_columns     TYPE REF TO cl_salv_columns_table,
        lo_column      TYPE REF TO cl_salv_column_table,
        lo_functions   TYPE REF TO cl_salv_functions_list,
        lv_choice      TYPE flag,
        lt_names       TYPE STANDARD TABLE OF zzs_alv_popup_names,
        ls_names       TYPE zzs_alv_popup_names,
        lv_title       TYPE c LENGTH 80.

  FIELD-SYMBOLS: <fs_table> TYPE STANDARD TABLE.

  IF it_table IS INITIAL.
    RETURN.
  ENDIF.

  " Assign title safely (convert string → char)
  lv_title = iv_title.

  TRY.

      " Create popup container - POSITION is mandatory on older GUI versions
      CREATE OBJECT lo_container
        EXPORTING
          caption  = lv_title
          top      = iv_start_line
          left     = iv_start_col
          width    = iv_end_col
          height   = iv_end_line
          position = 1.  " 1=centered, 2=top-left, etc. for older kernels

      " Create SALV table
      CALL METHOD cl_salv_table=>factory
        EXPORTING
          r_container = lo_container
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table = it_table.

      " Display settings
      lo_display = lo_alv->get_display_settings( ).
      CALL METHOD lo_display->set_striped_pattern
        EXPORTING value = abap_true.

      CALL METHOD lo_display->set_list_header
        EXPORTING value = lv_title.

      " Columns and headers
      IF it_field_names IS NOT INITIAL.
        lt_names = it_field_names.
        lo_columns = lo_alv->get_columns( ).
        LOOP AT lt_names INTO ls_names.
          TRY.
              lo_column = lo_columns->get_column( ls_names-fieldname ).

              " Older kernel requires explicit VALUE assignment
              CALL METHOD lo_column->set_short_text
                EXPORTING
                  value = ls_names-heading.

              CALL METHOD lo_column->set_medium_text
                EXPORTING
                  value = ls_names-heading.

              CALL METHOD lo_column->set_long_text
                EXPORTING
                  value = ls_names-heading.

            CATCH cx_salv_not_found.
          ENDTRY.
        ENDLOOP.
      ENDIF.

      " Toolbar functions
      lo_functions = lo_alv->get_functions( ).
      CALL METHOD lo_functions->set_all
        EXPORTING value = abap_true.

      CALL METHOD lo_functions->add_function
        EXPORTING
          name    = 'CONTINUE'
          icon    = '@42@'
          text    = 'Continue'
          tooltip = 'Confirm and continue'.

      CALL METHOD lo_functions->add_function
        EXPORTING
          name    = 'CANCEL'
          icon    = '@0A@'
          text    = 'Cancel'
          tooltip = 'Cancel selection'.

      " Display ALV
      CALL METHOD lo_alv->display.

      " Flush GUI to render
      CALL METHOD cl_gui_cfw=>flush.

      " Basic wait for user action (for popup)
      WAIT UP TO 1 SECONDS.

      " Default continue
      lv_choice = 'X'.

      " Cleanup
      IF lo_container IS BOUND.
        CALL METHOD lo_container->free.
      ENDIF.

    CATCH cx_salv_existing
          cx_salv_wrong_call
          cx_salv_msg INTO DATA(lx_salv).
      MESSAGE lx_salv->get_text( ) TYPE 'E'.
  ENDTRY.

  ev_choice = lv_choice.

ENDFUNCTION.