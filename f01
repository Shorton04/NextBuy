*---------------------------------------------------------------------*
* FORM: update_user_status (Batch BAPI call)
*---------------------------------------------------------------------*
FORM update_user_status.
  DATA: lt_header_all  TYPE TABLE OF bapi_alm_order_headers_i,
        lt_status_all  TYPE TABLE OF bapi_alm_order_usrstat,
        lt_methods_all TYPE TABLE OF bapi_alm_order_method,
        lt_return      TYPE TABLE OF bapiret2,
        ls_return      TYPE bapiret2,
        lt_to_process  TYPE TABLE OF lty_log,
        lv_action      TYPE string VALUE ( COND #( WHEN p_reset = abap_true THEN 'RESET' ELSE 'SET' ) ).

  LOOP AT gt_log INTO DATA(ls_log) WHERE light = 'Y'.
    APPEND ls_log TO lt_to_process.
  ENDLOOP.

  IF lt_to_process IS INITIAL.
    EXIT.
  ENDIF.

  DATA(lv_refnum) = 1.

  LOOP AT lt_to_process INTO DATA(ls_proc).
    APPEND VALUE #( orderid = ls_proc-aufnr ) TO lt_header_all.

    IF lv_action = 'SET'.
      APPEND VALUE #( orderid = ls_proc-aufnr user_st_text = 'KCMP' langu = p_spras ) TO lt_status_all.
    ELSE.
      APPEND VALUE #( orderid = ls_proc-aufnr user_st_text = 'KCMP' inactive = 'X' langu = p_spras ) TO lt_status_all.
    ENDIF.

    DATA(lv_ref) = |{ lv_refnum ALPHA = IN }|.
    APPEND VALUE #( refnumber = lv_ref objecttype = 'HEADER'  method = 'CHANGE' objectkey = ls_proc-aufnr ) TO lt_methods_all.
    APPEND VALUE #( refnumber = lv_ref objecttype = 'USERSTATUS' method = 'CHANGE' objectkey = ls_proc-aufnr ) TO lt_methods_all.
    APPEND VALUE #( refnumber = lv_ref objecttype = 'ORDER' method = 'SAVE' objectkey = ls_proc-aufnr ) TO lt_methods_all.

    lv_refnum = lv_refnum + 1.
  ENDLOOP.

  CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
    TABLES
      it_header     = lt_header_all
      it_methods    = lt_methods_all
      it_userstatus = lt_status_all
      return        = lt_return.

  READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
  IF sy-subrc = 0.
    LOOP AT gt_log INTO DATA(ls_fail) WHERE light = 'Y'.
      ls_fail-msgtxt = ls_return-message(72).
      ls_fail-light  = 'R'.
      MODIFY gt_log FROM ls_fail TRANSPORTING msgtxt light WHERE aufnr = ls_fail-aufnr.
    ENDLOOP.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    RETURN.
  ENDIF.

  LOOP AT gt_log INTO DATA(ls_succ) WHERE light = 'Y'.
    IF lv_action = 'SET'.
      ls_succ-msgtxt = |KCMP set successfully ({ gc_estat })|.
    ELSE.
      ls_succ-msgtxt = |KCMP reset successfully ({ gc_estat })|.
    ENDIF.
    ls_succ-light = 'G'.
    MODIFY gt_log FROM ls_succ TRANSPORTING msgtxt light WHERE aufnr = ls_succ-aufnr.
  ENDLOOP.

  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.

  LOOP AT lt_to_process INTO DATA(ls_rel).
    PERFORM release_locks USING ls_rel-aufnr.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: display_execution_log
*---------------------------------------------------------------------*
FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns_table,
        lo_col  TYPE REF TO cl_salv_column,
        lo_func TYPE REF TO cl_salv_functions,
        ls_log  TYPE lty_log,
        lx_msg  TYPE REF TO cx_salv_msg,
        lx_nf   TYPE REF TO cx_salv_not_found.

  IF gt_log IS INITIAL.
    MESSAGE 'No orders processed.' TYPE 'I'.
    EXIT.
  ENDIF.

  TRY.
      CALL METHOD cl_salv_table=>factory
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table      = gt_log.

      lo_func = lo_alv->get_functions( ).
      lo_func->set_all( abap_true ).

      lo_cols = lo_alv->get_columns( ).

      CALL METHOD lo_cols->get_column EXPORTING columnname = 'AUFNR' RECEIVING value = lo_col.
      lo_col->set_short_text( 'Order' ).
      lo_col->set_medium_text( 'Order Number' ).
      lo_col->set_long_text( 'Maintenance Order Number' ).

      CALL METHOD lo_cols->get_column EXPORTING columnname = 'AUART' RECEIVING value = lo_col.
      lo_col->set_medium_text( 'Order Type' ).

      CALL METHOD lo_cols->get_column EXPORTING columnname = 'IWERK' RECEIVING value = lo_col.
      lo_col->set_medium_text( 'Plant' ).

      CALL METHOD lo_cols->get_column EXPORTING columnname = 'MSGTXT' RECEIVING value = lo_col.
      lo_col->set_medium_text( 'Component Check' ).

      CALL METHOD lo_cols->get_column EXPORTING columnname = 'LIGHT' RECEIVING value = lo_col.
      lo_col->set_medium_text( 'Result' ).

      lo_alv->display( ).

    CATCH cx_salv_not_found INTO lx_nf.
      MESSAGE lx_nf->get_text( ) TYPE 'I'.
    CATCH cx_salv_msg INTO lx_msg.
      LOOP AT gt_log INTO ls_log.
        WRITE: / ls_log-aufnr, ls_log-iwerk, ls_log-msgtxt.
      ENDLOOP.
  ENDTRY.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: release_locks (same as original)
*---------------------------------------------------------------------*
FORM release_locks USING p_aufnr TYPE aufk-aufnr.

  DATA: lv_fm_used TYPE funcname VALUE space,
        lt_fms     TYPE TABLE OF funcname,
        lv_fm      TYPE funcname,
        lv_exists  TYPE funcname,
        lv_msg     TYPE char100.

  DATA: lv_aufnr    TYPE aufk-aufnr,
        lv_rsnum    TYPE resb-rsnum,
        lv_prueflos TYPE qals-prueflos,
        lv_qmnum    TYPE qmel-qmnum,
        lv_objnr    TYPE jest-objnr.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING input = p_aufnr
    IMPORTING output = lv_aufnr.

  SELECT SINGLE rsnum INTO @lv_rsnum
    FROM resb WHERE aufnr = @lv_aufnr AND xloek = @space.

  SELECT SINGLE prueflos INTO @lv_prueflos
    FROM qals WHERE aufnr = @lv_aufnr.

  SELECT SINGLE qmnum INTO @lv_qmnum
    FROM qmel WHERE aufnr = @lv_aufnr.

  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

  lt_fms = VALUE #(
    ( 'DEQUEUE_EAUFK' ) ( 'DEQUEUE_EAFKO' ) ( 'DEQUEUE_EAFVC' )
    ( 'DEQUEUE_EEQUI' ) ( 'DEQUEUE_EIFLOT' ) ( 'DEQUEUE_ERESB' )
    ( 'DEQUEUE_ERKPF' ) ( 'DEQUEUE_EQALS' ) ( 'DEQUEUE_EQMEL' )
  ).

  LOOP AT lt_fms INTO lv_fm.
    SELECT SINGLE funcname INTO lv_exists FROM tfdir WHERE funcname = lv_fm.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    TRY.
        CASE lv_fm.
          WHEN 'DEQUEUE_EAUFK' OR 'DEQUEUE_EAFKO'.
            CALL FUNCTION lv_fm EXPORTING aufnr = lv_aufnr.
          WHEN 'DEQUEUE_EAFVC'.
            CALL FUNCTION lv_fm EXPORTING objnr = lv_objnr.
          WHEN 'DEQUEUE_ERESB' OR 'DEQUEUE_ERKPF'.
            IF lv_rsnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING rsnum = lv_rsnum.
            ENDIF.
          WHEN 'DEQUEUE_EQALS'.
            IF lv_prueflos IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING prueflos = lv_prueflos.
            ENDIF.
          WHEN 'DEQUEUE_EQMEL'.
            IF lv_qmnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING qmnum = lv_qmnum.
            ENDIF.
        ENDCASE.
      CATCH cx_root INTO DATA(lx_root).
        CONTINUE.
    ENDTRY.
  ENDLOOP.

  CALL FUNCTION 'DEQUEUE_ALL'.

  CONCATENATE 'Locks released for order' lv_aufnr INTO lv_msg SEPARATED BY space.
  WRITE: / lv_msg.
ENDFORM.