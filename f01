*---------------------------------------------------------------------*
* Get first operation (Optimized: use prefetched join)
*---------------------------------------------------------------------*
FORM f_get_operation USING ps_order TYPE viaufkst
                     CHANGING pv_vornr TYPE afvc-vornr.

  DATA: ls_op TYPE ty_op.

  IF gt_operations IS INITIAL.
    " Prefetch all operations for all orders
    SELECT a~aufnr, v~vornr, v~objnr
      FROM afko AS a
      INNER JOIN afvc AS v ON a~aufpl = v~aufpl
      FOR ALL ENTRIES IN @gt_orders
      WHERE a~aufnr = @gt_orders-aufnr
      INTO TABLE @gt_operations.

    SORT gt_operations BY aufnr.
  ENDIF.

  READ TABLE gt_operations INTO ls_op
    WITH KEY aufnr = ps_order-aufnr BINARY SEARCH.
  IF sy-subrc = 0.
    pv_vornr = ls_op-vornr.
  ELSE.
    pv_vornr = ''.
  ENDIF.

ENDFORM.