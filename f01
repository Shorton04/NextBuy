*---------------------------------------------------------------------*
* Filter by status (inclusive/exclusive) — Join version
*---------------------------------------------------------------------*
FORM filter_by_jest.

  DATA lt_keep TYPE TABLE OF lty_order.

  SELECT DISTINCT a~aufnr,
                  a~auart,
                  b~iwerk,
                  a~erdat,
                  c~gstrp,
                  c~gltrp,
                  a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    INNER JOIN jest AS j ON a~objnr = j~objnr
    WHERE j~inact = @space
      AND j~stat IN @s_statin          " inclusive statuses
      AND j~stat NOT IN @s_statex      " exclusive statuses
      AND a~aufnr IN @s_aufnr
      AND b~iwerk IN @s_iwerk
    INTO TABLE @lt_keep.

  gt_orders = lt_keep.

ENDFORM.





*---------------------------------------------------------------------*
* Filter only orders having active components — Join version
*---------------------------------------------------------------------*
FORM filter_has_components.

  DATA lt_keep TYPE TABLE OF lty_order.

  SELECT a~aufnr,
         a~auart,
         b~iwerk,
         a~erdat,
         c~gstrp,
         c~gltrp,
         a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE EXISTS (
      SELECT 1 FROM resb AS r
        WHERE r~aufnr = a~aufnr
          AND r~xloek = @space )
      AND a~aufnr IN @s_aufnr
    INTO TABLE @lt_keep.

  gt_orders = lt_keep.

ENDFORM.



*---------------------------------------------------------------------*
* Evaluate kitting completeness using join (S/4HANA optimized)
*---------------------------------------------------------------------*
FORM evaluate_kitting.

  DATA lt_comp TYPE TABLE OF resb.

  SELECT a~aufnr,
         a~auart,
         b~iwerk,
         a~erdat,
         c~gstrp,
         c~gltrp,
         r~postp,
         r~enmng,
         r~bdmng
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    INNER JOIN resb AS r ON a~aufnr = r~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND r~xloek = @space
    INTO TABLE @lt_comp.

  LOOP AT gt_orders INTO DATA(ls_ord).
    DATA(lv_l_complete) = abap_true.
    DATA(lv_n_complete) = abap_true.
    DATA(lv_ready) = abap_false.

    LOOP AT lt_comp INTO DATA(ls_r)
         WHERE aufnr = ls_ord-aufnr.

      IF ls_r-postp = gc_postp_l AND p_reserv = abap_true.
        IF ls_r-enmng < ls_r-bdmng.
          lv_l_complete = abap_false.
          EXIT.
        ENDIF.
      ENDIF.

      IF ls_r-postp = gc_postp_n AND p_preq = abap_true.
        IF ls_r-enmng < ls_r-bdmng.
          lv_n_complete = abap_false.
          EXIT.
        ENDIF.
      ENDIF.
    ENDLOOP.

    " Determine readiness
    IF ( p_reserv = abap_true AND p_preq = abap_true AND
         lv_l_complete = abap_true AND lv_n_complete = abap_true )
     OR ( p_reserv = abap_true AND p_preq = abap_false AND lv_l_complete = abap_true )
     OR ( p_reserv = abap_false AND p_preq = abap_true AND lv_n_complete = abap_true )
     OR ( p_reserv = abap_false AND p_preq = abap_false ).
      lv_ready = abap_true.
    ENDIF.

    IF lv_ready = abap_true.
      APPEND VALUE lty_log(
        aufnr  = ls_ord-aufnr
        auart  = ls_ord-auart
        iwerk  = ls_ord-iwerk
        erdat  = ls_ord-erdat
        gstrp  = ls_ord-gstrp
        gltrp  = ls_ord-gltrp
        msgtxt = 'Ready to set KCMP'
        light  = icon_led_yellow ) TO gt_log.
    ELSE.
      APPEND VALUE lty_log(
        aufnr  = ls_ord-aufnr
        auart  = ls_ord-auart
        iwerk  = ls_ord-iwerk
        erdat  = ls_ord-erdat
        gstrp  = ls_ord-gstrp
        gltrp  = ls_ord-gltrp
        msgtxt = 'Incomplete components'
        light  = icon_led_red ) TO gt_log.
    ENDIF.
  ENDLOOP.

ENDFORM.