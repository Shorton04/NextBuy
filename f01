FORM display_execution_log.

  DATA: lo_alv  TYPE REF TO cl_salv_table,
        lo_cols TYPE REF TO cl_salv_columns,
        lo_col  TYPE REF TO cl_salv_column,
        lx_msg  TYPE REF TO cx_salv_msg,
        lx_nf   TYPE REF TO cx_salv_not_found.

  IF gt_log IS INITIAL.
    MESSAGE i006(ZA2R_KCMPMSG). "No data available to display.
    EXIT.
  ENDIF.

  " convert 'G'/'R'/'Y' to LED icons for SALV display
  LOOP AT gt_log ASSIGNING FIELD-SYMBOL(<fs_log>).
    CASE <fs_log>-light.
      WHEN 'G'. <fs_log>-light = gc_light_green.
      WHEN 'R'. <fs_log>-light = gc_light_red.
      WHEN OTHERS. <fs_log>-light = gc_light_inact.
    ENDCASE.
  ENDLOOP.

  TRY.
      cl_salv_table=>factory(
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table      = gt_log ).

      lo_alv->get_functions( )->set_all( abap_true ).
      lo_cols = lo_alv->get_columns( ).
      lo_cols->set_optimize( abap_true ).

      " Column headers (optional)
      TRY. lo_col = lo_cols->get_column( 'AUFNR' ). lo_col->set_medium_text( 'Order' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'AUART' ). lo_col->set_medium_text( 'Order Type' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'IWERK' ). lo_col->set_medium_text( 'Plant' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'ERDAT' ). lo_col->set_medium_text( 'Created On' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'GSTRP' ). lo_col->set_medium_text( 'Basic Start' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'GLTRP' ). lo_col->set_medium_text( 'Basic Finish' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'MSGTXT' ). lo_col->set_medium_text( 'Status Message' ). CATCH cx_salv_not_found. ENDTRY.
      TRY. lo_col = lo_cols->get_column( 'LIGHT' ). lo_col->set_medium_text( 'Result' ). CATCH cx_salv_not_found. ENDTRY.

      lo_alv->display( ).

    CATCH cx_salv_not_found INTO lx_nf.
      MESSAGE lx_nf->get_text( ) TYPE 'I'.
    CATCH cx_salv_msg INTO lx_msg.
      MESSAGE lx_msg->get_text( ) TYPE 'I'.
  ENDTRY.

ENDFORM.
