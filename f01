*---------------------------------------------------------------------*
* FORM: init_defaults
*---------------------------------------------------------------------*
FORM init_defaults.
  gv_user = sy-uname.
  gv_now  = sy-datum.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: get_kcmp_status
*---------------------------------------------------------------------*
FORM get_kcmp_status.
  DATA lv_estat TYPE tj30-estat.

  SELECT SINGLE j~estat
    INTO @lv_estat
    FROM tj30 AS j
    INNER JOIN tj30t AS t
      ON j~estat = t~estat
     AND j~stsma = t~stsma
   WHERE t~txt04 = @p_estat
     AND t~spras = @p_spras.

  IF sy-subrc <> 0 OR lv_estat IS INITIAL.
    MESSAGE |User status text "{ p_estat }" not found for language { p_spras }.| TYPE 'E'.
  ELSE.
    gc_estat = lv_estat.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: validate_selection
*---------------------------------------------------------------------*
FORM validate_selection.
  IF s_aufnr[] IS INITIAL AND s_iwerk[] IS INITIAL.
    MESSAGE 'Please enter at least one Order or Plant.' TYPE 'E'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: fetch_orders
*---------------------------------------------------------------------*
FORM fetch_orders.
  CLEAR gt_orders.

  SELECT a~aufnr, a~auart, b~iwerk, a~erdat, c~gstrp, c~gltrp, a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    INTO TABLE @DATA(lt_temp)
    WHERE ( a~aufnr IN @s_aufnr OR @s_aufnr[] IS INITIAL )
      AND ( a~auart IN @s_auart OR @s_auart[] IS INITIAL )
      AND ( b~iwerk IN @s_iwerk OR @s_iwerk[] IS INITIAL ).

  IF s_erdat[] IS NOT INITIAL.
    DELETE lt_temp WHERE erdat NOT IN s_erdat.
  ENDIF.
  IF s_gstrp[] IS NOT INITIAL.
    DELETE lt_temp WHERE gstrp NOT IN s_gstrp.
  ENDIF.
  IF s_gltrp[] IS NOT INITIAL.
    DELETE lt_temp WHERE gltrp NOT IN s_gltrp.
  ENDIF.

  gt_orders = lt_temp.

  IF gt_orders IS INITIAL.
    MESSAGE 'No orders found for selection criteria.' TYPE 'I'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_by_jest
*---------------------------------------------------------------------*
FORM filter_by_jest.
  DATA lt_keep TYPE TABLE OF lty_order.

  SELECT DISTINCT a~aufnr, a~auart, b~iwerk, a~erdat,
                  c~gstrp, c~gltrp, a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    INNER JOIN jest AS j ON a~objnr = j~objnr
    WHERE j~inact = @space
      AND ( ( j~stat IN @s_statin ) OR @s_statin[] IS INITIAL )
      AND ( ( j~stat NOT IN @s_statex ) OR @s_statex[] IS INITIAL )
      AND a~aufnr IN @gt_orders[ ]-aufnr
    INTO TABLE @lt_keep.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: filter_has_components
*---------------------------------------------------------------------*
FORM filter_has_components.
  DATA lt_keep TYPE TABLE OF lty_order.

  SELECT DISTINCT a~aufnr, a~auart, b~iwerk, a~erdat,
                  c~gstrp, c~gltrp, a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE a~aufnr IN @gt_orders[ ]-aufnr
      AND EXISTS (
        SELECT 1 FROM resb AS r
         WHERE r~aufnr = a~aufnr
           AND r~xloek = @space )
    INTO TABLE @lt_keep.

  gt_orders = lt_keep.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.
  DATA: lt_resb TYPE TABLE OF resb,
        ls_resb TYPE resb.

  LOOP AT gt_orders INTO DATA(ls_order).
    SELECT * FROM resb INTO TABLE @lt_resb
      WHERE aufnr = @ls_order-aufnr
        AND xloek = @space.

    IF lt_resb IS INITIAL.
      APPEND VALUE #( aufnr = ls_order-aufnr auart = ls_order-auart iwerk = ls_order-iwerk
                      erdat = ls_order-erdat gstrp = ls_order-gstrp gltrp = ls_order-gltrp
                      msgtxt = 'No components' light = gc_light_inact ) TO gt_log.
      CONTINUE.
    ENDIF.

    DATA(lv_has_L) = abap_false.
    DATA(lv_all_L_ok) = abap_true.
    DATA(lv_has_N) = abap_false.
    DATA(lv_all_N_ok) = abap_true.

    LOOP AT lt_resb INTO ls_resb.
      IF ls_resb-postp = gc_postp_l.
        lv_has_L = abap_true.
        IF ls_resb-enmng < ls_resb-bdmng.
          lv_all_L_ok = abap_false.
        ENDIF.
      ELSEIF ls_resb-postp = gc_postp_n.
        lv_has_N = abap_true.
        IF ls_resb-enmng < ls_resb-bdmng.
          lv_all_N_ok = abap_false.
        ENDIF.
      ENDIF.
    ENDLOOP.

    DATA(lv_ready) = abap_false.
    IF p_reserv = abap_true AND p_preq = abap_true.
      IF lv_all_L_ok = abap_true AND lv_all_N_ok = abap_true.
        lv_ready = abap_true.
      ENDIF.
    ELSEIF p_reserv = abap_true.
      IF lv_all_L_ok = abap_true.
        lv_ready = abap_true.
      ENDIF.
    ELSEIF p_preq = abap_true.
      IF lv_all_N_ok = abap_true.
        lv_ready = abap_true.
      ENDIF.
    ENDIF.

    IF lv_ready = abap_true.
      APPEND VALUE #( aufnr = ls_order-aufnr auart = ls_order-auart iwerk = ls_order-iwerk
                      erdat = ls_order-erdat gstrp = ls_order-gstrp gltrp = ls_order-gltrp
                      msgtxt = 'Ready to set KCMP' light = gc_light_green ) TO gt_log.
    ELSE.
      APPEND VALUE #( aufnr = ls_order-aufnr auart = ls_order-auart iwerk = ls_order-iwerk
                      erdat = ls_order-erdat gstrp = ls_order-gstrp gltrp = ls_order-gltrp
                      msgtxt = 'Incomplete components' light = gc_light_red ) TO gt_log.
    ENDIF.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: check_authorizations
*---------------------------------------------------------------------*
FORM check_authorizations.
  AUTHORITY-CHECK OBJECT 'C_AFKO_ACT' ID 'ACTVT' FIELD '02'.
  IF sy-subrc <> 0.
    MESSAGE 'User not authorized to change orders (C_AFKO_ACT ACTVT 02).' TYPE 'E'.
  ENDIF.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: update_user_status
*---------------------------------------------------------------------*
FORM update_user_status.
  LOOP AT gt_log INTO DATA(ls_log_orig).

    IF p_set = abap_true AND ls_log_orig-light <> gc_light_green.
      CONTINUE.
    ENDIF.

    DATA(lv_aufnr) = ls_log_orig-aufnr.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING input = lv_aufnr
      IMPORTING output = lv_aufnr.

    DATA(lv_objnr) TYPE jest-objnr.
    CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

    " Determine status profile
    DATA(lv_stsma) TYPE jsto-stsma.
    SELECT SINGLE stsma INTO lv_stsma FROM jsto WHERE objnr = lv_objnr.
    IF sy-subrc <> 0 OR lv_stsma IS INITIAL.
      ls_log_orig-msgtxt = 'Status profile not found.'.
      ls_log_orig-light  = gc_light_red.
      MODIFY gt_log FROM ls_log_orig.
      CONTINUE.
    ENDIF.

    " Determine ESTAT for this profile
    DATA(lv_estat_for_order) = ''.
    SELECT SINGLE j~estat INTO lv_estat_for_order
      FROM tj30 AS j INNER JOIN tj30t AS t
        ON j~estat = t~estat AND j~stsma = t~stsma
     WHERE j~stsma = @lv_stsma
       AND t~txt04 = @p_estat
       AND t~spras = @p_spras.

    IF sy-subrc <> 0 OR lv_estat_for_order IS INITIAL.
      ls_log_orig-msgtxt = |User status { p_estat } not available for profile { lv_stsma }.|.
      ls_log_orig-light  = gc_light_red.
      MODIFY gt_log FROM ls_log_orig.
      CONTINUE.
    ENDIF.

    AUTHORITY-CHECK OBJECT 'I_IWERK' ID 'IWERK' FIELD ls_log_orig-iwerk.
    IF sy-subrc <> 0.
      ls_log_orig-msgtxt = |No authorization for plant { ls_log_orig-iwerk }.|.
      ls_log_orig-light  = gc_light_red.
      MODIFY gt_log FROM ls_log_orig.
      CONTINUE.
    ENDIF.

    " Already present?
    DATA(lv_present) = abap_false.
    SELECT SINGLE * FROM jest INTO @DATA(ls_jest)
      WHERE objnr = @lv_objnr AND stat = @lv_estat_for_order AND inact = @space.
    IF sy-subrc = 0.
      lv_present = abap_true.
    ENDIF.

    IF p_set = abap_true AND lv_present = abap_true.
      ls_log_orig-msgtxt = 'KCMP already set'.
      ls_log_orig-light  = gc_light_inact.
      MODIFY gt_log FROM ls_log_orig.
      CONTINUE.
    ENDIF.
    IF p_reset = abap_true AND lv_present = abap_false.
      ls_log_orig-msgtxt = 'KCMP not present'.
      ls_log_orig-light  = gc_light_inact.
      MODIFY gt_log FROM ls_log_orig.
      CONTINUE.
    ENDIF.

    " Prepare BAPI structures
    DATA: lt_header  TYPE TABLE OF bapi_alm_order_headers_i,
          lt_methods TYPE TABLE OF bapi_alm_order_method,
          lt_usrstat TYPE TABLE OF bapi_alm_order_usrstat,
          lt_return  TYPE TABLE OF bapiret2,
          ls_return  TYPE bapiret2.

    APPEND VALUE #( orderid = lv_aufnr ) TO lt_header.

    APPEND VALUE #( refnumber = '00001' objecttype = 'USERSTATUS'
                    method = 'CHANGE' objectkey = lv_aufnr ) TO lt_methods.
    APPEND VALUE #( refnumber = '00002' objecttype = 'ORDER'
                    method = 'SAVE' objectkey = lv_aufnr ) TO lt_methods.

    APPEND VALUE #( user_st_text = p_estat
                    langu        = p_spras
                    inactive     = COND #( WHEN p_reset = abap_true THEN 'X' ELSE '' ) )
                    TO lt_usrstat.

    CALL FUNCTION 'BAPI_ALM_ORDER_MAINTAIN'
      TABLES it_header     = lt_header
             it_methods    = lt_methods
             it_userstatus = lt_usrstat
             return        = lt_return.

    READ TABLE lt_return INTO ls_return WITH KEY type = 'E'.
    IF sy-subrc = 0.
      ls_log_orig-msgtxt = ls_return-message.
      ls_log_orig-light  = gc_light_red.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING wait = 'X'.
      IF p_reset = abap_true.
        ls_log_orig-msgtxt = |KCMP reset successfully ({ lv_estat_for_order })|.
        ls_log_orig-light  = gc_light_inact.
      ELSE.
        ls_log_orig-msgtxt = |KCMP set successfully ({ lv_estat_for_order })|.
        ls_log_orig-light  = gc_light_green.
      ENDIF.
    ENDIF.

    ls_log_orig-stsma = lv_stsma.
    ls_log_orig-bapi_id = ls_return-id.
    ls_log_orig-bapi_no = ls_return-number.
    ls_log_orig-bapi_msg = ls_return-message.
    ls_log_orig-timestamp = sy-datum.
    ls_log_orig-uname = sy-uname.

    MODIFY gt_log FROM ls_log_orig.
  ENDLOOP.

  COMMIT WORK.
ENDFORM.

*---------------------------------------------------------------------*
* FORM: display_execution_log
*---------------------------------------------------------------------*
FORM display_execution_log.
  DATA: lo_alv  TYPE REF TO cl_salv_table.

  IF gt_log IS INITIAL.
    MESSAGE 'No data available to display.' TYPE 'I'.
    RETURN.
  ENDIF.

  LOOP AT gt_log ASSIGNING FIELD-SYMBOL(<fs_log>).
    IF <fs_log>-light IS INITIAL.
      <fs_log>-light = gc_light_inact.
    ENDIF.
  ENDLOOP.

  cl_salv_table=>factory( IMPORTING r_salv_table = lo_alv CHANGING t_table = gt_log ).
  lo_alv->get_functions( )->set_all( abap_true ).
  lo_alv->get_columns( )->set_optimize( abap_true ).
  lo_alv->display( ).
ENDFORM.


*---------------------------------------------------------------------*
* FORM: release_locks
*---------------------------------------------------------------------*
FORM release_locks USING p_aufnr TYPE aufk-aufnr.

  DATA: lv_aufnr    TYPE aufk-aufnr,
        lv_rsnum    TYPE resb-rsnum,
        lv_prueflos TYPE qals-prueflos,
        lv_qmnum    TYPE qmel-qmnum,
        lv_objnr    TYPE jest-objnr,
        lt_fms      TYPE TABLE OF funcname,
        lv_fm       TYPE funcname,
        lv_exists   TYPE funcname.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING input = p_aufnr
    IMPORTING output = lv_aufnr.

  " Gather related objects
  SELECT SINGLE rsnum INTO @lv_rsnum FROM resb
   WHERE aufnr = @lv_aufnr AND xloek = @space.

  SELECT SINGLE prueflos INTO @lv_prueflos FROM qals
   WHERE aufnr = @lv_aufnr.

  SELECT SINGLE qmnum INTO @lv_qmnum FROM qmel
   WHERE aufnr = @lv_aufnr.

  CONCATENATE 'OR' lv_aufnr INTO lv_objnr.

  " Build list of possible DEQUEUE FMs
  lt_fms = VALUE #(
    ( 'DEQUEUE_EAUFK' )   " Order Header
    ( 'DEQUEUE_EAFKO' )   " Order Master
    ( 'DEQUEUE_EAFVC' )   " Operations
    ( 'DEQUEUE_EEQUI' )   " Equipment
    ( 'DEQUEUE_EIFLOT' )  " Functional Location
    ( 'DEQUEUE_ERESB' )   " Reservation
    ( 'DEQUEUE_ERKPF' )   " Reservation Header
    ( 'DEQUEUE_EQALS' )   " Inspection Lot
    ( 'DEQUEUE_EQMEL' )   " Notification
  ).

  LOOP AT lt_fms INTO lv_fm.
    SELECT SINGLE funcname INTO lv_exists FROM tfdir WHERE funcname = lv_fm.
    IF sy-subrc <> 0.
      CONTINUE.
    ENDIF.

    TRY.
        CASE lv_fm.
          WHEN 'DEQUEUE_EAUFK' OR 'DEQUEUE_EAFKO'.
            CALL FUNCTION lv_fm EXPORTING aufnr = lv_aufnr.
          WHEN 'DEQUEUE_EAFVC'.
            CALL FUNCTION lv_fm EXPORTING objnr = lv_objnr.
          WHEN 'DEQUEUE_ERESB' OR 'DEQUEUE_ERKPF'.
            IF lv_rsnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING rsnum = lv_rsnum.
            ENDIF.
          WHEN 'DEQUEUE_EQALS'.
            IF lv_prueflos IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING prueflos = lv_prueflos.
            ENDIF.
          WHEN 'DEQUEUE_EQMEL'.
            IF lv_qmnum IS NOT INITIAL.
              CALL FUNCTION lv_fm EXPORTING qmnum = lv_qmnum.
            ENDIF.
        ENDCASE.
      CATCH cx_root INTO DATA(lx_root).
        CONTINUE.
    ENDTRY.
  ENDLOOP.

  CALL FUNCTION 'DEQUEUE_ALL'.
ENDFORM.