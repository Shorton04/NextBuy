FORM f_get_operation USING    ps_order TYPE viaufkst
                     CHANGING pv_vornr TYPE afvc-vornr.

  DATA: lv_aufpl TYPE afko-aufpl,
        lv_stat  TYPE jest-stat,
        pv_found TYPE abap_bool VALUE abap_false.

  " Define structure and table for operations
  TYPES: BEGIN OF ty_op,
           vornr TYPE afvc-vornr,
           objnr TYPE afvc-objnr,
         END OF ty_op.

  DATA: ls_op      TYPE ty_op,
        lt_ops     TYPE TABLE OF ty_op,
        lt_jest_op TYPE TABLE OF jest,
        ls_jest_op TYPE jest.

  CLEAR pv_vornr.

  " Step 1: Get routing number for this order (AFKO)
  SELECT SINGLE aufpl
    INTO @lv_aufpl
    FROM afko
   WHERE aufnr = @ps_order-aufnr.

  IF sy-subrc <> 0 OR lv_aufpl IS INITIAL.
    RETURN. " No routing found for this order
  ENDIF.

  " Step 2: Get operations linked to that routing (AFVC)
  SELECT vornr, objnr
    FROM afvc
    WHERE aufpl = @lv_aufpl
    ORDER BY aplzl
    INTO TABLE @lt_ops.

  IF lt_ops IS INITIAL.
    RETURN.
  ENDIF.

  " Step 3: Prefetch all JEST statuses for these operations
  SELECT objnr, stat, inact
    FROM jest
    FOR ALL ENTRIES IN @lt_ops
    WHERE objnr = @lt_ops-objnr
    INTO TABLE @lt_jest_op.

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  " Step 4: Loop and find the first active (not deleted) operation
  LOOP AT lt_ops INTO ls_op.

    READ TABLE lt_jest_op INTO ls_jest_op
         WITH KEY objnr = ls_op-objnr
                  stat  = 'I0013'
                  inact = ''.

    " If not found in JEST as 'deleted', it's a valid operation
    IF sy-subrc <> 0.
      pv_vornr = ls_op-vornr.
      pv_found = abap_true.
      EXIT. " Found valid operation
    ENDIF.

  ENDLOOP.

  " Step 5: No valid operation found
  IF pv_found = abap_false.
    pv_vornr = ''.
  ENDIF.

ENDFORM.