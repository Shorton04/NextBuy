METHOD handle_inbound.
  DATA(ls_data) = VALUE zstr_p2m_mes_inbound( ).
  e_result = 'ERROR'.

  TRY.
      parse_payload( EXPORTING i_payload = i_payload
                     IMPORTING es_data = ls_data ).

      log_message( EXPORTING is_data = ls_data
                              i_payload = i_payload
                              iv_flag   = 'N'
                              iv_error  = '' ).

      IF check_idempotency( is_data = ls_data ) = abap_true.
        log_message( EXPORTING is_data = ls_data
                                i_payload = i_payload
                                iv_flag   = 'P'
                                iv_error  = 'DUPLICATE' ).
        e_result = 'DUPLICATE'.
        RETURN.
      ENDIF.

      update_mapping_table( is_data = ls_data ).

      IF aggregate_and_update_status( is_data = ls_data ) = abap_true.
        log_message( EXPORTING is_data = ls_data
                                i_payload = i_payload
                                iv_flag   = 'P'
                                iv_error  = '' ).
        e_result = 'OK'.
      ELSE.
        log_message( EXPORTING is_data = ls_data
                                i_payload = i_payload
                                iv_flag   = 'E'
                                iv_error  = 'UPDATE_FAILED' ).
        e_result = 'ERROR'.
      ENDIF.

    CATCH cx_root INTO DATA(lx).
      log_message( EXPORTING is_data = ls_data
                              i_payload = i_payload
                              iv_flag   = 'E'
                              iv_error  = lx->get_text( ) ).
      e_result = 'ERROR'.
  ENDTRY.
ENDMETHOD.





METHOD parse_payload.
  TRY.
      /ui2/cl_json=>deserialize(
        EXPORTING json = i_payload
        CHANGING  data = es_data
      ).
    CATCH cx_root INTO DATA(lx).
      RAISE EXCEPTION TYPE cx_root EXPORTING textid = lx->get_text( ).
  ENDTRY.
ENDMETHOD.



METHOD check_idempotency.
  rv_duplicate = abap_false.
  SELECT SINGLE message_id FROM zmes_log
    WHERE message_id = @is_data-messageid
      AND process_flag = 'P'.
  IF sy-subrc = 0.
    rv_duplicate = abap_true.
  ENDIF.
ENDMETHOD.




METHOD log_message.
  DATA(ls_log) = VALUE zmes_log(
    message_id    = is_data-messageid
    aufnr         = is_data-processorder
    vornr         = is_data-operation
    mes_order_id  = is_data-mesorderid
    status_in     = is_data-status
    received_ts   = sy-datum && sy-uzeit
    payload       = i_payload
    process_flag  = iv_flag
    error_text    = iv_error ).

  SELECT SINGLE * FROM zmes_log WHERE message_id = @ls_log-message_id.
  IF sy-subrc = 0.
    UPDATE zmes_log SET
      process_flag = @ls_log-process_flag,
      error_text   = @ls_log-error_text,
      retry_cnt    = retry_cnt + 1
      WHERE message_id = @ls_log-message_id.
  ELSE.
    INSERT zmes_log VALUES ls_log.
  ENDIF.
ENDMETHOD.




METHOD update_mapping_table.
  DATA(ls_link) = VALUE zmes_link(
    aufnr         = is_data-processorder
    vornr         = is_data-operation
    zmes_order_id = is_data-mesorderid
    mes_status    = is_data-status
    created_at    = sy-datum && sy-uzeit
    message_id    = is_data-messageid
    created_by    = sy-uname ).

  SELECT SINGLE * FROM zmes_link
    WHERE aufnr = @ls_link-aufnr
      AND vornr = @ls_link-vornr
      AND zmes_order_id = @ls_link-zmes_order_id.
  IF sy-subrc = 0.
    UPDATE zmes_link SET
      mes_status   = @ls_link-mes_status,
      last_upd_at  = @ls_link-created_at,
      message_id   = @ls_link-message_id
      WHERE aufnr = @ls_link-aufnr
        AND vornr = @ls_link-vornr
        AND zmes_order_id = @ls_link-zmes_order_id.
  ELSE.
    INSERT zmes_link VALUES ls_link.
  ENDIF.
ENDMETHOD.




METHOD aggregate_and_update_status.
  rv_ok = abap_false.

  DATA: lt_links TYPE TABLE OF zmes_link,
        lv_not_done TYPE abap_bool VALUE abap_false.

  SELECT * FROM zmes_link INTO TABLE lt_links
    WHERE aufnr = @is_data-processorder
      AND vornr = @is_data-operation.

  IF is_data-status = 'STARTED'.
    rv_ok = confirm_operation_by_bapi( is_data = is_data ).
    RETURN.
  ENDIF.

  IF is_data-status = 'COMPLETED'.
    LOOP AT lt_links INTO DATA(ls_link).
      IF ls_link-mes_status <> 'COMPLETED'.
        lv_not_done = abap_true.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_not_done = abap_false.
      rv_ok = confirm_operation_by_bapi( is_data = is_data ).
    ELSE.
      rv_ok = abap_true.
    ENDIF.
  ENDIF.
ENDMETHOD.





METHOD confirm_operation_by_bapi.
  rv_ok = abap_false.

  TRY.
      CALL FUNCTION 'BAPI_PRODORDCONF_CREATE_TT'
        EXPORTING
          orderid = is_data-processorder
        TABLES
          t_conf = DATA(lt_conf). " adjust per your system

      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait = 'X'.
      rv_ok = abap_true.
    CATCH cx_root INTO DATA(lx).
      rv_ok = abap_false.
  ENDTRY.
ENDMETHOD.



