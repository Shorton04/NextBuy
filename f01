*---------------------------------------------------------------------*
* FORM: filter_by_jest (optimized for S/4HANA)
*---------------------------------------------------------------------*
FORM filter_by_jest.
  DATA: lt_jest_all TYPE TABLE OF jest,
        lt_keep     TYPE STANDARD TABLE OF lty_order WITH EMPTY KEY,
        lt_objnrs   TYPE TABLE OF jest-objnr,
        ht_jest_all TYPE HASHED TABLE OF jest WITH UNIQUE KEY objnr stat.

  "---------------------------------------------------------------*
  " 1. Collect all OBJNR from gt_orders
  "---------------------------------------------------------------*
  lt_objnrs = VALUE #( FOR ls_ord IN gt_orders ( ls_ord-objnr ) ).

  "---------------------------------------------------------------*
  " 2. Select all active statuses in one go
  "---------------------------------------------------------------*
  SELECT objnr, stat
    FROM jest
    FOR ALL ENTRIES IN @lt_objnrs
    WHERE objnr = @lt_objnrs-table_line
      AND inact = @space
    INTO TABLE @lt_jest_all.

  IF sy-subrc = 0.
    ht_jest_all = lt_jest_all.
  ENDIF.

  "---------------------------------------------------------------*
  " 3. Filter orders based on inclusion/exclusion logic
  "---------------------------------------------------------------*
  LOOP AT gt_orders INTO DATA(ls_ord).
    DATA(lv_include) = abap_true.

    " Exclude if order has a status in S_STATEX
    LOOP AT s_statex ASSIGNING FIELD-SYMBOL(<ls_statex>).
      READ TABLE ht_jest_all
           WITH TABLE KEY objnr = ls_ord-objnr stat = <ls_statex>-low
           TRANSPORTING NO FIELDS.
      IF sy-subrc = 0.
        lv_include = abap_false.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_include = abap_true.
      " Include if order has any status in S_STATIN
      LOOP AT s_statin ASSIGNING FIELD-SYMBOL(<ls_statin>).
        READ TABLE ht_jest_all
             WITH TABLE KEY objnr = ls_ord-objnr stat = <ls_statin>-low
             TRANSPORTING NO FIELDS.
        IF sy-subrc = 0.
          APPEND ls_ord TO lt_keep.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDLOOP.

  gt_orders = lt_keep.
ENDFORM.








*---------------------------------------------------------------------*
* FORM: filter_has_components (optimized for S/4HANA)
*---------------------------------------------------------------------*
FORM filter_has_components.
  DATA: lt_resb_exist TYPE TABLE OF resb-aufnr,
        lt_keep       TYPE STANDARD TABLE OF lty_order WITH EMPTY KEY,
        ht_resb_exist TYPE HASHED TABLE OF resb-aufnr WITH UNIQUE KEY table_line.

  " Select all distinct order numbers from RESB in one go
  SELECT DISTINCT aufnr
    FROM resb
    FOR ALL ENTRIES IN @gt_orders
    WHERE aufnr = @gt_orders-aufnr
      AND xloek = @space
    INTO TABLE @lt_resb_exist.

  IF sy-subrc = 0.
    ht_resb_exist = lt_resb_exist.
  ENDIF.

  LOOP AT gt_orders INTO DATA(ls_ord).
    READ TABLE ht_resb_exist WITH TABLE KEY table_line = ls_ord-aufnr TRANSPORTING NO FIELDS.
    IF sy-subrc = 0.
      APPEND ls_ord TO lt_keep.
    ENDIF.
  ENDLOOP.

  gt_orders = lt_keep.
ENDFORM.