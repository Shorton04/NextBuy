FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_START_COL)  TYPE  I DEFAULT 25
*"     REFERENCE(IV_START_LINE) TYPE  I DEFAULT 6
*"     REFERENCE(IV_END_COL)    TYPE  I DEFAULT 100
*"     REFERENCE(IV_END_LINE)   TYPE  I DEFAULT 20
*"     REFERENCE(IV_TITLE)      TYPE  STRING DEFAULT 'ALV'
*"     REFERENCE(IT_FIELD_NAMES) TYPE STANDARD TABLE OPTIONAL
*"  EXPORTING
*"     REFERENCE(EV_CHOICE) TYPE FLAG
*"  CHANGING
*"     REFERENCE(IT_TABLE)  TYPE STANDARD TABLE OPTIONAL
*"----------------------------------------------------------------------

  DATA: lo_container   TYPE REF TO cl_gui_dialogbox_container,
        lo_alv         TYPE REF TO cl_salv_table,
        lo_display     TYPE REF TO cl_salv_display_settings,
        lo_columns     TYPE REF TO cl_salv_columns_table,
        lo_column      TYPE REF TO cl_salv_column_table,
        lo_functions   TYPE REF TO cl_salv_functions_list,
        lv_user_action TYPE sy-ucomm,
        lv_choice      TYPE flag,
        lt_names       TYPE STANDARD TABLE OF zzs_alv_popup_names,
        ls_names       TYPE zzs_alv_popup_names.

  FIELD-SYMBOLS: <fs_table> TYPE STANDARD TABLE.

  IF it_table IS INITIAL.
    RETURN.
  ENDIF.

  TRY.

      " Create popup container
      CREATE OBJECT lo_container
        EXPORTING
          caption = CONV string( iv_title )   " must be string-compatible
          top     = iv_start_line
          left    = iv_start_col
          width   = iv_end_col
          height  = iv_end_line.

      " Create SALV table
      cl_salv_table=>factory(
        EXPORTING
          r_container = lo_container
        IMPORTING
          r_salv_table = lo_alv
        CHANGING
          t_table = it_table ).

      " Display settings
      lo_display = lo_alv->get_display_settings( ).
      lo_display->set_striped_pattern( abap_true ).
      lo_display->set_list_header( CONV string( iv_title ) ).

      " Columns and headers
      IF it_field_names IS NOT INITIAL.
        lt_names = it_field_names.
        lo_columns = lo_alv->get_columns( ).
        LOOP AT lt_names INTO ls_names.
          TRY.
              lo_column = lo_columns->get_column( ls_names-fieldname ).
              lo_column->set_short_text( CONV string( ls_names-heading ) ).
              lo_column->set_medium_text( CONV string( ls_names-heading ) ).
              lo_column->set_long_text( CONV string( ls_names-heading ) ).
            CATCH cx_salv_not_found.
          ENDTRY.
        ENDLOOP.
      ENDIF.

      " Toolbar functions
      lo_functions = lo_alv->get_functions( ).
      lo_functions->set_all( abap_true ).

      lo_functions->add_function(
        name    = 'CONTINUE'
        icon    = '@42@'
        text    = 'Continue'
        tooltip = 'Confirm and continue' ).

      lo_functions->add_function(
        name    = 'CANCEL'
        icon    = '@0A@'
        text    = 'Cancel'
        tooltip = 'Cancel selection' ).

      " Display ALV
      lo_alv->display( ).

      " GUI flush to render the container
      CALL METHOD cl_gui_cfw=>flush.

      " Wait for user command (simple modal wait)
      WAIT UP TO 1 SECONDS.

      " Default: if user closes dialog (X)
      lv_choice = 'X'.

      " Clean up container
      IF lo_container IS BOUND.
        CALL METHOD lo_container->free.
      ENDIF.

    CATCH cx_salv_existing cx_salv_wrong_call INTO DATA(lx_salv).
      MESSAGE lx_salv->get_text( ) TYPE 'E'.
  ENDTRY.

  ev_choice = lv_choice.

ENDFUNCTION.