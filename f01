CLASS zcl_mes_if_inbound DEFINITION
  PUBLIC
  CREATE PUBLIC .

  PUBLIC SECTION.
    METHODS:
      handle_inbound
        IMPORTING
          i_payload TYPE string
        RETURNING
          VALUE(e_result) TYPE char10.

  PROTECTED SECTION.
  PRIVATE SECTION.
    TYPES: BEGIN OF ty_in,
             processorder TYPE aufnr,
             operation    TYPE vornr,
             mesorderid   TYPE string,
             status       TYPE string,
             timestamp    TYPE timestamp,
             messageid    TYPE string,
           END OF ty_in.

    METHODS:
      parse_payload
        IMPORTING  i_payload TYPE string
        EXPORTING  es_in TYPE ty_in
        RAISING    cx_root.

    METHODS:
      check_idempotency
        IMPORTING is_in TYPE ty_in
        RETURNING VALUE(rv_duplicate) TYPE abap_bool.

    METHODS:
      log_message
        IMPORTING is_in TYPE ty_in i_payload TYPE string iv_flag TYPE char1 iv_err TYPE string.

    METHODS:
      update_mapping_table
        IMPORTING is_in TYPE ty_in.

    METHODS:
      aggregate_and_update_status
        IMPORTING is_in TYPE ty_in
        RETURNING VALUE(rv_ok) TYPE abap_bool.

    METHODS:
      conf_operation_by_bapi
        IMPORTING is_in TYPE ty_in
        RETURNING VALUE(rv_ok) TYPE abap_bool.

ENDCLASS.


CLASS zcl_mes_if_inbound IMPLEMENTATION.

  METHOD handle_inbound.
    DATA(ls_in) = VALUE ty_in( ).
    e_result = 'ERROR'.

    TRY.
        parse_payload( i_payload = i_payload
                       es_in     = ls_in ).

        " write raw message to log as NEW initially
        log_message( is_in = ls_in i_payload = i_payload iv_flag = 'N' iv_err = '' ).

        " idempotency check
        IF check_idempotency( ls_in ) = abap_true.
          " duplicate -> mark as processed and return OK
          log_message( is_in = ls_in i_payload = i_payload iv_flag = 'P' iv_err = 'DUPLICATE' ).
          e_result = 'DUPLICATE'.
          RETURN.
        ENDIF.

        " Try to update mapping table
        update_mapping_table( is_in = ls_in ).

        " Aggregate and update operation status
        IF aggregate_and_update_status( is_in = ls_in ) = abap_true.
          log_message( is_in = ls_in i_payload = i_payload iv_flag = 'P' iv_err = '' ).
          e_result = 'OK'.
        ELSE.
          " failed to update SAP statuses - log as error
          log_message( is_in = ls_in i_payload = i_payload iv_flag = 'E' iv_err = 'UPDATE_FAILED' ).
          e_result = 'ERROR'.
        ENDIF.

      CATCH cx_root INTO DATA(lx).
        " generic error handling
        log_message( is_in = ls_in i_payload = i_payload iv_flag = 'E' iv_err = lx->get_text( ) ).
        e_result = 'ERROR'.
    ENDTRY.
  ENDMETHOD.


  METHOD parse_payload.
    " Expect JSON structure, use /UI2/CL_JSON for deserialization
    TRY.
        DATA(lo_json) = NEW /ui2/cl_json( ).
        " Using deserialize to an internal table/structure is more robust.
        DATA(lv_json) = i_payload.
        " Map JSON fields manually
        DATA(lt_map) = VALUE string_table( ).
        " quick deserial to generic data object - create field mapping
        DATA(ls_struct) = VALUE ty_in( ).
        /ui2/cl_json=>deserialize( EXPORTING json = lv_json CHANGING data = ls_struct ).
        es_in = ls_struct.
      CATCH cx_root INTO DATA(lx).
        RAISE EXCEPTION TYPE cx_root.
    ENDTRY.
  ENDMETHOD.


  METHOD check_idempotency.
    " Return true if message id already processed
    rv_duplicate = abap_false.
    IF is_in-messageid IS NOT INITIAL.
      SELECT SINGLE * FROM zmes_log
        WHERE message_id = @is_in-messageid AND process_flag = 'P'.
      IF sy-subrc = 0.
        rv_duplicate = abap_true.
      ENDIF.
    ENDIF.
  ENDMETHOD.


  METHOD log_message.
    " Write/Update into ZMES_LOG
    DATA: ls_log TYPE zmes_log.
    CLEAR ls_log.
    ls_log-message_id = is_in-messageid.
    ls_log-aufnr      = is_in-processorder.
    ls_log-vornr      = is_in-operation.
    ls_log-mes_order_id = is_in-mesorderid.
    ls_log-status_in  = is_in-status.
    ls_log-received_ts = sy-uzeit && sy-datum. " or use timestamp get internal table
    ls_log-payload    = i_payload.
    ls_log-process_flag = iv_flag.
    ls_log-error_text = iv_err.

    " Upsert into ZMES_LOG: prefer UPDATE -> if not exist INSERT
    SELECT SINGLE * FROM zmes_log
      WHERE message_id = ls_log-message_id.
    IF sy-subrc = 0.
      UPDATE zmes_log SET
        process_flag = ls_log-process_flag,
        error_text   = ls_log-error_text,
        retry_cnt    = retry_cnt + 1
      WHERE message_id = ls_log-message_id.
    ELSE.
      INSERT zmes_log VALUES ls_log.
    ENDIF.
  ENDMETHOD.


  METHOD update_mapping_table.
    " Insert or update link record for this mesOrderid
    DATA ls_link TYPE zmes_link.
    CLEAR ls_link.
    ls_link-aufnr = is_in-processorder.
    ls_link-vornr = is_in-operation.
    ls_link-zmes_order_id = is_in-mesorderid.
    ls_link-mes_status = is_in-status.
    ls_link-created_at = sy-datum && sy-uzeit.
    ls_link-message_id = is_in-messageid.
    ls_link-created_by = sy-uname.

    " If exists update, else insert
    SELECT SINGLE * FROM zmes_link
      WHERE aufnr = ls_link-aufnr AND vornr = ls_link-vornr AND zmes_order_id = ls_link-zmes_order_id.
    IF sy-subrc = 0.
      UPDATE zmes_link SET
        mes_status   = ls_link-mes_status,
        last_upd_at  = ls_link-created_at,
        message_id   = ls_link-message_id
      WHERE aufnr = ls_link-aufnr AND vornr = ls_link-vornr AND zmes_order_id = ls_link-zmes_order_id.
    ELSE.
      INSERT zmes_link VALUES ls_link.
    ENDIF.
  ENDMETHOD.


  METHOD aggregate_and_update_status.
    " Determine if op should be STARTED or COMPLETED based on all MES orders for this AUFNR/VORNR
    rv_ok = abap_false.
    DATA: lt_links TYPE TABLE OF zmes_link,
          lv_any_not_completed TYPE abap_bool VALUE abap_false.

    SELECT * FROM zmes_link INTO TABLE lt_links
      WHERE aufnr = is_in-processorder AND vornr = is_in-operation.

    IF sy-subrc <> 0.
      " no mapping entries found -> still attempt to update status for single mapping
      " but do not fail hard; insert a single mapping above already did
    ENDIF.

    " If incoming status is STARTED => if there is no existing started flag, set op STARTED
    IF is_in-status = 'STARTED'.
      " Check whether operation already has a started system status via table JEST or via stored flag - simplified: call BAPI to create partial confirmation
      rv_ok = conf_operation_by_bapi( is_in = is_in ).
      RETURN.
    ENDIF.

    " If incoming status is COMPLETED -> check all mes orders for that op are COMPLETED
    IF is_in-status = 'COMPLETED'.
      LOOP AT lt_links INTO DATA(ls_link).
        IF ls_link-mes_status <> 'COMPLETED'.
          lv_any_not_completed = abap_true.
          EXIT.
        ENDIF.
      ENDLOOP.

      IF lv_any_not_completed = abap_false.
        " All MES orders completed -> final confirmation
        rv_ok = conf_operation_by_bapi( is_in = is_in ).
      ELSE.
        " partial completions - do not finalize SAP op; optionally post partial confirmation
        " Post a partial confirmation (yield=0) or do nothing
        rv_ok = abap_true.
      ENDIF.
      RETURN.
    ENDIF.

    " unknown status - mark as error
    rv_ok = abap_false.
  ENDMETHOD.


  METHOD conf_operation_by_bapi.
    " Use production order confirmation BAPI. Example: BAPI_PRODORDCONF_CREATE_TT or CO* functions.
    rv_ok = abap_false.

    TRY.
      " Prepare internal tables for the BAPI
      DATA: lt_head   TYPE TABLE OF bapiparex,    " adjust types based on BAPI signature
            lt_items  TYPE TABLE OF bapime, etc.

      " Simpler option: use BAPI_PRODORDCONF_CREATE_TT (check your system for correct BAPI signature)
      CALL FUNCTION 'BAPI_PRODORDCONF_CREATE_TT'
        EXPORTING
          orderid = is_in-processorder
*         other params as required...
        TABLES
          t_conf = DATA(lt_conf)   " adjust per BAPI
        EXCEPTIONS
          OTHERS = 1.
      IF sy-subrc <> 0.
        " Write error to log and raise
        RAISE EXCEPTION TYPE cx_root.
      ENDIF.

      " Commit work
      PERFORM commit_work.
      rv_ok = abap_true.

    CATCH cx_root INTO DATA(lx).
      rv_ok = abap_false.
    ENDTRY.
  ENDMETHOD.

ENDCLASS.