FUNCTION zlonza_alv_popup_table.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(iv_start_col) TYPE i DEFAULT 25
*"     REFERENCE(iv_start_line) TYPE i DEFAULT 6
*"     REFERENCE(iv_end_col)   TYPE i DEFAULT 120
*"     REFERENCE(iv_end_line)  TYPE i DEFAULT 25
*"     REFERENCE(iv_title)     TYPE string DEFAULT 'ALV Display'
*"  EXPORTING
*"     REFERENCE(ev_choice)    TYPE flag
*"  CHANGING
*"     REFERENCE(it_table)     TYPE STANDARD TABLE OPTIONAL
*"----------------------------------------------------------------------

  DATA: lo_container       TYPE REF TO cl_gui_dialogbox_container,
        lo_salv            TYPE REF TO cl_salv_table,
        lo_functions       TYPE REF TO cl_salv_functions,
        lo_display         TYPE REF TO cl_salv_display_settings,
        lo_selections      TYPE REF TO cl_salv_selections,
        lv_caption_s       TYPE string,
        lv_caption_c       TYPE c LENGTH 80,
        lv_answer          TYPE c.

  FIELD-SYMBOLS: <fs_table> TYPE STANDARD TABLE.

  IF it_table IS INITIAL.
    RETURN.
  ENDIF.

  " Prepare caption types
  lv_caption_s = iv_title.
  lv_caption_c = lv_caption_s. " safely assign to CHAR(80)

  " Create popup container for ALV (needs CHAR caption)
  CREATE OBJECT lo_container
    EXPORTING
      caption = lv_caption_c
      top     = iv_start_line
      left    = iv_start_col
      width   = iv_end_col
      height  = iv_end_line.

  TRY.
      " Create SALV table inside popup container
      CALL METHOD cl_salv_table=>factory
        EXPORTING
          r_container = lo_container
        IMPORTING
          r_salv_table = lo_salv
        CHANGING
          t_table      = it_table.

      " === No chained calls from here on ===
      CALL METHOD lo_salv->get_functions
        RECEIVING
          value = lo_functions.

      CALL METHOD lo_functions->set_all
        EXPORTING
          value = abap_true.

      CALL METHOD lo_salv->get_display_settings
        RECEIVING
          value = lo_display.

      CALL METHOD lo_display->set_list_header
        EXPORTING
          value = lv_caption_s.

      CALL METHOD lo_display->set_striped_pattern
        EXPORTING
          value = abap_true.

      CALL METHOD lo_salv->get_selections
        RECEIVING
          value = lo_selections.

      CALL METHOD lo_selections->set_selection_mode
        EXPORTING
          value = if_salv_c_selection_mode=>row_column.

      " Display the SALV ALV grid
      CALL METHOD lo_salv->display.

      " Popup confirmation
      CALL FUNCTION 'POPUP_TO_CONFIRM'
        EXPORTING
          titlebar       = lv_caption_s
          text_question  = 'Do you want to continue?'
          text_button_1  = 'Yes'
          text_button_2  = 'No'
          default_button = '1'
        IMPORTING
          answer         = lv_answer.

      IF lv_answer = '1'.
        ev_choice = abap_true.
      ELSE.
        ev_choice = abap_false.
      ENDIF.

    CATCH cx_salv_msg INTO DATA(lx_salv).
      MESSAGE lx_salv->get_text( ) TYPE 'E'.
  ENDTRY.

  " Free container
  IF lo_container IS BOUND.
    CALL METHOD lo_container->free.
  ENDIF.

ENDFUNCTION.