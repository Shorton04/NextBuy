*---------------------------------------------------------------------*
* F01 Include: FORM Routines
*---------------------------------------------------------------------*

FORM init_data.
  DATA: lt_mtart TYPE STANDARD TABLE OF mara-mtart,
        lv_datum TYPE datum.

  CLEAR: s_mtart[], s_mtart.
  SELECT SINGLE * FROM ztxca_param INTO @DATA(ls_param)
    WHERE kdef01 = 'ZKROHRECOG_MATTYPE_SELECTION'
      AND kval03 = 'MTART'
      AND pval01 = 'X'.
  IF sy-subrc = 0.
    IF NOT ls_param-pval02 IS INITIAL.
      CLEAR lt_mtart.
      SPLIT ls_param-pval02 AT ',' INTO TABLE lt_mtart.
      LOOP AT lt_mtart INTO DATA(ls_mtart)
        WHERE table_line IS NOT INITIAL.
        s_mtart-sign = 'I'.
        s_mtart-option = 'EQ'.
        s_mtart-low = ls_mtart.
        APPEND s_mtart.
      ENDLOOP.
    ENDIF.
    IF NOT ls_param-pval03 IS INITIAL.
      CLEAR lt_mtart.
      SPLIT ls_param-pval03 AT ',' INTO TABLE lt_mtart.
      LOOP AT lt_mtart INTO ls_mtart WHERE table_line IS NOT INITIAL.
        s_mtart-sign = 'I'.
        s_mtart-option = 'EQ'.
        s_mtart-low = ls_mtart.
        APPEND s_mtart.
      ENDLOOP.
    ENDIF.
    IF NOT ls_param-pval04 IS INITIAL.
      CLEAR lt_mtart.
      SPLIT ls_param-pval04 AT ',' INTO TABLE lt_mtart.
      LOOP AT lt_mtart INTO ls_mtart WHERE table_line IS NOT INITIAL.
        s_mtart-sign = 'I'.
        s_mtart-option = 'EQ'.
        s_mtart-low = ls_mtart.
        APPEND s_mtart.
      ENDLOOP.
    ENDIF.
  ENDIF.

  CLEAR: s_exdate[], s_exdate.
  lv_datum = sy-datum.
  CALL FUNCTION 'RP_LAST_DAY_OF_MONTHS'
    EXPORTING day_in = lv_datum
    IMPORTING last_day_of_month = lv_datum.
  IF sy-subrc = 0.
    s_exdate-sign = 'I'.
    s_exdate-option = 'LE'.
    s_exdate-low = lv_datum.
    APPEND s_exdate.
    CLEAR s_exdate.
  ENDIF.

  gt_r_psphi  = s_psphi[].
  gt_r_pspnr  = s_pspnr[].
  gt_r_werks  = s_werks[].
  gt_r_charg  = s_charg[].
  gt_r_matnr  = s_matnr[].
  gt_r_mtart  = s_mtart[].
  gt_r_exdate = s_exdate[].
  gt_r_amtsr  = s_amtsr[].
  gt_r_ernam  = s_ernam[].
  gt_r_erdat  = s_erdat[].
  gt_r_status = s_status[].
  gv_batrel   = p_batrel.

ENDFORM.

*---------------------------------------------------------------------*
* VALIDATE_DATA
*---------------------------------------------------------------------*
FORM validate_data.
  CASE sy-ucomm.
    WHEN 'EXECUTE'.
      CASE abap_true.
        WHEN p_rb1.
          IF s_werks[] IS INITIAL.
            MESSAGE 'Please Maintain Plant' TYPE 'E'.
          ENDIF.
          IF s_charg[] IS INITIAL.
            MESSAGE 'Please Maintain Batch' TYPE 'E'.
          ENDIF.
        WHEN p_rb2.
          IF s_psphi[] IS INITIAL AND s_pspnr[] IS INITIAL.
            MESSAGE 'Please Maintain either Project or WBS' TYPE 'E'.
          ENDIF.
      ENDCASE.
    WHEN 'REC'.
      s_psphi[]  = gt_r_psphi[].
      s_pspnr[]  = gt_r_pspnr[].
      s_werks[]  = gt_r_werks[].
      s_charg[]  = gt_r_charg[].
      s_matnr[]  = gt_r_matnr[].
      s_mtart[]  = gt_r_mtart[].
      s_exdate[] = gt_r_exdate[].
      s_amtsr[]  = gt_r_amtsr[].
      s_ernam[]  = gt_r_ernam[].
      s_erdat[]  = gt_r_erdat[].
      s_status[] = gt_r_status[].
      p_batrel   = gv_batrel.
  ENDCASE.
ENDFORM.

*---------------------------------------------------------------------*
* MODIFY_SCREEN
*---------------------------------------------------------------------*
FORM modify_screen.
  LOOP AT SCREEN.
    CASE screen-group1.
      WHEN 'M1'. IF p_rb1 IS INITIAL. screen-active = 0. ENDIF.
      WHEN 'M2'. IF p_rb2 IS INITIAL. screen-active = 0. ENDIF.
      WHEN 'M3'. IF p_rb3 IS INITIAL. screen-active = 0. ENDIF.
      WHEN 'M4'. IF NOT p_rb1 IS INITIAL. screen-active = 0. ENDIF.
      WHEN 'M5'. IF NOT p_rb2 IS INITIAL. screen-active = 0. ENDIF.
    ENDCASE.
    MODIFY SCREEN.
  ENDLOOP.
ENDFORM.

*---------------------------------------------------------------------*
* BDC ROUTINES
*---------------------------------------------------------------------*
FORM bdc_dynpro USING iv_program iv_dynpro
                CHANGING ct_bdcdata TYPE bdcdata_tab.
  CLEAR gs_bdcdata.
  gs_bdcdata-program  = iv_program.
  gs_bdcdata-dynpro   = iv_dynpro.
  gs_bdcdata-dynbegin = 'X'.
  APPEND gs_bdcdata TO ct_bdcdata.
ENDFORM.

FORM bdc_field USING iv_fnam iv_fval
               CHANGING ct_bdcdata TYPE bdcdata_tab.
  CLEAR gs_bdcdata.
  gs_bdcdata-fnam = iv_fnam.
  WRITE iv_fval TO gs_bdcdata-fval LEFT-JUSTIFIED.
  APPEND gs_bdcdata TO ct_bdcdata.
ENDFORM.


*---------------------------------------------------------------------*
* EXECUTE_PROGRAM
*---------------------------------------------------------------------*
FORM execute_program.

  " Create Controller Instance
  CREATE OBJECT go_controller
    TYPE zcl_a2d_controller.

  " Create Model-View Instance (optional)
  CREATE OBJECT go_model_view
    TYPE zcl_a2d_revenue_recog_consmat.

  " Initialize selection data again if needed
  PERFORM init_data.

  " Fill structure for method
  CLEAR ls_parameters.
  ls_parameters-r_psphi[]  = gt_r_psphi[].
  ls_parameters-r_pspnr[]  = gt_r_pspnr[].
  ls_parameters-r_werks[]  = gt_r_werks[].
  ls_parameters-r_charg[]  = gt_r_charg[].
  ls_parameters-r_matnr[]  = gt_r_matnr[].
  ls_parameters-r_mtart[]  = gt_r_mtart[].
  ls_parameters-r_exdate[] = gt_r_exdate[].
  ls_parameters-r_amtsr[]  = gt_r_amtsr[].
  ls_parameters-r_ernam[]  = gt_r_ernam[].
  ls_parameters-r_erdat[]  = gt_r_erdat[].
  ls_parameters-r_status[] = gt_r_status[].
  ls_parameters-p_batrel   = gv_batrel.

  " Call the controller method
  CALL METHOD go_controller->select_result
    EXPORTING
      is_parameters = ls_parameters.

ENDFORM.