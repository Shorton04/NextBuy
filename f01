FUNCTION zrfw_controller_m01_v01_l02 .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_PARAMETER_STRUCT_NAME) TYPE  STRING
*"     REFERENCE(IV_RESULT_STRUCT_NAME) TYPE  STRING
*"     REFERENCE(IO_VIEW_REPORT) TYPE REF TO  ZIF_A2D_VIEW_REPORT
*"     REFERENCE(IO_VIEW_ALV) TYPE REF TO  ZIF_A2D_VIEW_ALV
*"     REFERENCE(IO_MODEL_SELECTION) TYPE REF TO
*"        ZIF_A2D_MODEL_SELECTION
*"     REFERENCE(IV_REPORT_ID) TYPE  SYREPID
*"     REFERENCE(IV_PARAMETER_SUBSCR_ID) TYPE  SYDYNNR
*"  EXPORTING
*"     REFERENCE(EO_CONTROLLER) TYPE REF TO  ZCL_A2D_CONTROLLER
*"----------------------------------------------------------------------

* set global parameter
  gv_report_id           = iv_report_id.
  gv_parameter_subscr_id = iv_parameter_subscr_id.

* create controller object
  CREATE OBJECT go_controller
    TYPE zcl_a2d_controller_m01_v01_l02
    EXPORTING
      iv_report_id             = iv_report_id
      iv_alv_screen_id         = '9001'
      iv_parameter_struct_name = iv_parameter_struct_name
      iv_result_struct_name    = iv_result_struct_name
      io_view_report           = io_view_report
      io_view_alv              = io_view_alv
      io_model_selection       = io_model_selection.
  eo_controller = go_controller.

* run in dynpro mode or batch mode
  IF sy-batch IS INITIAL.
    " call parameter screen
    CALL SCREEN 9000.
  ELSE.
    " run in batch mode
    go_controller->run_as_batch( ).
  ENDIF.


ENDFUNCTION.
