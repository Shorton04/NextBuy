METHOD handle_inbound.
  DATA: ls_data TYPE zstr_p2m_mes_inbound,
        lv_json TYPE string,        "STRING variable for JSON
        lv_ok   TYPE abap_bool.

  TRY.
      " Convert from SSTRING (from structure or FM) to STRING
      lv_json = i_payload.

      " Parse JSON payload into structure
      me->parse_payload(
        EXPORTING
          i_payload = lv_json
        IMPORTING
          es_data   = ls_data ).

      " Idempotency check
      IF me->check_idempotency( ls_data ) = abap_true.
        me->log_message(
          is_data  = ls_data
          iv_error = 'Duplicate message (already processed)' ).
        RETURN.
      ENDIF.

      " Update mapping & status
      me->update_mapping_table( ls_data ).
      me->aggregate_and_update_status( ls_data ).

      " Call BAPI
      lv_ok = me->confirm_operation_by_bapi( ls_data ).

      IF lv_ok = abap_true.
        me->log_message( is_data = ls_data ).
      ELSE.
        me->log_message(
          is_data  = ls_data
          iv_error = 'BAPI confirmation failed' ).
      ENDIF.

    CATCH cx_root INTO DATA(lx).
      me->log_message(
        is_data  = ls_data
        iv_error = |{ lx->if_message~get_text( ) }| ).
  ENDTRY.

  rv_success = abap_true.
ENDMETHOD.