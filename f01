*---------------------------------------------------------------------*
* FORM: evaluate_kitting
*---------------------------------------------------------------------*
FORM evaluate_kitting.

  CLEAR gt_log.

  "--------------------------------------------------------------*
  " 1. Read Orders using a JOIN (AUFK + AFIH + AFKO)
  "--------------------------------------------------------------*
  SELECT a~aufnr,
         a~auart,
         b~iwerk,
         a~erdat,
         c~gstrp,
         c~gltrp,
         a~objnr
    FROM aufk AS a
    INNER JOIN afih AS b ON a~aufnr = b~aufnr
    INNER JOIN afko AS c ON a~aufnr = c~aufnr
    WHERE a~aufnr IN @s_aufnr
      AND a~auart IN @s_auart
      AND b~iwerk IN @s_iwerk
      AND a~erdat IN @s_erdat
      AND c~gstrp IN @s_gstrp
      AND c~gltrp IN @s_gltrp
    INTO TABLE @gt_orders.

  IF gt_orders IS INITIAL.
    MESSAGE 'No orders found for selection criteria.' TYPE 'I'.
    EXIT.
  ENDIF.

  "--------------------------------------------------------------*
  " 2. Evaluate completeness of components (RESB)
  "--------------------------------------------------------------*
  LOOP AT gt_orders INTO DATA(ls_ord).

    " Check component completeness using aggregation
    SELECT COUNT(*) AS total,
           SUM( CASE WHEN enmng < bdmng THEN 1 ELSE 0 END ) AS incomplete
      FROM resb
      WHERE aufnr = @ls_ord-aufnr
        AND xloek = @space
        AND postp IN ( @gc_postp_l, @gc_postp_n )
      INTO @DATA(ls_comp).

    CLEAR gs_log.
    MOVE-CORRESPONDING ls_ord TO gs_log.

    "------------------------------------------------------------*
    " 3. Evaluate completeness and assign traffic light
    "------------------------------------------------------------*
    IF ls_comp-incomplete > 0.
      gs_log-msgtxt = 'Incomplete components'.
      gs_log-light  = gc_light_red.
    ELSEIF ls_comp-total = 0.
      gs_log-msgtxt = 'No components found'.
      gs_log-light  = gc_light_inact.
    ELSE.
      gs_log-msgtxt = 'Kitting complete'.
      gs_log-light  = gc_light_green.
    ENDIF.

    APPEND gs_log TO gt_log.

  ENDLOOP.

ENDFORM.