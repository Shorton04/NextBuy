*&---------------------------------------------------------------------*
*& Include ZTR_A2R_KCMP_STATUS_TOP
*&---------------------------------------------------------------------*

TABLES: aufk, afih, afko, jest, jsto, resb.

"--------------------------------------------------------------------*
" Type Definitions
"--------------------------------------------------------------------*
TYPES: BEGIN OF lty_order,
         aufnr TYPE aufk-aufnr,
         auart TYPE aufk-auart,
         iwerk TYPE afih-iwerk,
         erdat TYPE aufk-erdat,
         gstrp TYPE afko-gstrp,
         gltrp TYPE afko-gltrp,
         objnr TYPE aufk-objnr,
       END OF lty_order.

TYPES: BEGIN OF lty_log,
         aufnr  TYPE aufk-aufnr,
         auart  TYPE aufk-auart,
         iwerk  TYPE afih-iwerk,
         msgtxt TYPE string,
         light  TYPE char1,  " G/Y/R indicator
       END OF lty_log.

"--------------------------------------------------------------------*
" Global Data
"--------------------------------------------------------------------*
DATA: gt_orders TYPE STANDARD TABLE OF lty_order WITH EMPTY KEY,
      gt_log    TYPE STANDARD TABLE OF lty_log   WITH EMPTY KEY.

DATA: gv_user  TYPE sy-uname,
      gv_now   TYPE sy-datum,
      gc_estat TYPE tj30-estat.  " internal KCMP code resolved dynamically

"--------------------------------------------------------------------*
" Constants
"--------------------------------------------------------------------*
CONSTANTS:
  gc_postp_l TYPE char1 VALUE 'L',  " Stock component
  gc_postp_n TYPE char1 VALUE 'N'.  " Non-stock component
