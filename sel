*---------------------------------------------------------------------*
* Include ZTR_A2R_KCMP_STATUS_SEL
* Selection screen definitions
*---------------------------------------------------------------------*

SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE text-s01.
SELECT-OPTIONS:
  s_aufnr FOR aufk-aufnr,  " Order Number
  s_auart FOR aufk-auart,  " Order Type
  s_iwerk FOR afih-iwerk,  " Plant
  s_erdat FOR aufk-erdat,  " Created On
  s_gstrp FOR afko-gstrp,  " Basic Start
  s_gltrp FOR afko-gltrp.  " Basic Finish
SELECTION-SCREEN END OF BLOCK b01.

SELECTION-SCREEN BEGIN OF BLOCK b04 WITH FRAME TITLE text-s04.
SELECT-OPTIONS:
  s_statin FOR jest-stat NO INTERVALS,  " Inclusive statuses (e.g. REL)
  s_statex FOR jest-stat NO INTERVALS.  " Exclusive statuses (e.g. KCMP, TECO)
SELECTION-SCREEN END OF BLOCK b04.

SELECTION-SCREEN BEGIN OF BLOCK b02 WITH FRAME TITLE text-s02.
PARAMETERS:
  p_reserv AS CHECKBOX DEFAULT 'X',  " Consider reservations
  p_preq   AS CHECKBOX DEFAULT 'X'.  " Consider purchase reqs
SELECTION-SCREEN END OF BLOCK b02.

SELECTION-SCREEN BEGIN OF BLOCK b03 WITH FRAME TITLE text-s03.
PARAMETERS:
  p_estat TYPE tj30t-txt04 DEFAULT 'KCMP', " User status text (KCMP)
  p_spras TYPE spras DEFAULT 'E' OBLIGATORY, " Language key
  p_set   RADIOBUTTON GROUP r1 DEFAULT 'X',  " Set KCMP
  p_reset RADIOBUTTON GROUP r1.              " Reset KCMP
SELECTION-SCREEN END OF BLOCK b03.